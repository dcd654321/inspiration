page {
  background: #f7f7fa;
  color: #1f1f27;
  font-size: 30rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  padding: 32rpx 28rpx 64rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.hint {
  color: #6b6b76;
  font-size: 26rpx;
}

.placeholder {
  border: 2rpx dashed #d5d5de;
  border-radius: 16rpx;
  padding: 40rpx 28rpx;
  color: #8a8a95;
  font-size: 26rpx;
  text-align: center;
}

.button-primary {
  background: #3d3d8f;
  color: #ffffff;
  border-radius: 16rpx;
  margin-top: 24rpx;
}
