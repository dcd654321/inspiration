/* 全局样式与设计令牌。
 *
 * 令牌值来自 docs/ui-design.md 第 1 节，界面原型见 docs/ui-mockup.html。
 * 原型用的是 375px 视口下的 px，这里是 750rpx 设计稿下的 rpx——**换算关系是 ×2**。
 * 改这里的值之前先确认设计文档也跟着改了，否则真机与原型会对不上。
 */

page {
  /* 墨色由深到浅 */
  --ink: #191a23;
  --ink-2: #5f6070;
  --ink-3: #6f6f7b;

  --paper: #f7f6f2;          /* 页面底色：轻微暖调，呼应纸页 */
  --surface: #ffffff;        /* 承载面 */
  --line: #e6e4de;           /* 发丝分隔线 */
  --line-strong: #d7d4cb;

  --brand: #34377f;
  --brand-soft: #eeeef8;
  --brand-line: #c9cae6;
  --spark: #e4a83a;
  --spark-soft: #fff6df;

  --danger: #b43c32;
  --danger-soft: #fbeeec;
  --danger-line: #efc9c4;

  --warn-ink: #8a6420;
  --warn-soft: #fdf4e3;

  background: var(--paper);
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
}

/* ---------------------------------------------------------------- 布局 */

.page {
  padding: 40rpx 40rpx calc(64rpx + env(safe-area-inset-bottom));
}

.page-title {
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: -0.02em;
  line-height: 1.3;
}

.page-sub {
  font-size: 28rpx;
  color: var(--ink-2);
  line-height: 1.7;
  margin-top: 10rpx;
}

/* 承载面：只在真正需要「一整块内容」的地方用，不滥用卡片把页面切成一格一格 */
.panel {
  background: var(--surface);
  border-radius: 24rpx;
}

.divider {
  height: 1rpx;
  background: var(--line);
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-head .k {
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: var(--ink-2);
}

.section-head .v {
  font-size: 26rpx;
  color: var(--ink-3);
}

/* ---------------------------------------------------------------- 按钮 */

.btn {
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 0.01em;
  border: none;
  border-radius: 16rpx;
  min-height: 88rpx;
  padding: 0 44rpx;
  background: var(--brand);
  color: #ffffff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.btn::after { border: none; }  /* 去掉小程序 button 默认的边框 */

.page .btn-block {
  display: flex;
  width: 100%;
}

.btn[disabled],
.btn.is-disabled {
  background: #e4e4ec;
  color: var(--ink-3);
}

.btn-quiet {
  background: transparent;
  color: var(--brand);
  border: 2rpx solid var(--brand-line);
}

.btn-plain {
  background: var(--surface);
  color: var(--ink-2);
  border: 2rpx solid var(--line-strong);
}

.btn-danger {
  background: transparent;
  color: var(--danger);
  border: 2rpx solid var(--danger-line);
}

.btn-sm {
  min-height: 88rpx;
  font-size: 28rpx;
  padding: 0 32rpx;
  border-radius: 14rpx;
}

.btn-link {
  min-height: 88rpx;
  padding: 0 12rpx;
  background: transparent;
  color: var(--brand);
  font-size: 27rpx;
}

.btn-link::after { border: none; }

/* ---------------------------------------------------------------- 提示条 */

/* 关键失败一律用页面内联，不用会消失的 toast——用户错过之后会以为已经成功 */
.notice {
  display: flex;
  align-items: flex-start;
  margin-top: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.notice .mark {
  flex: 0 0 auto;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  margin: 4rpx 18rpx 0 0;
  position: relative;
}

.notice .mark::before {
  content: "";
  position: absolute;
  left: 13rpx;
  top: 8rpx;
  width: 4rpx;
  height: 11rpx;
  background: #ffffff;
  border-radius: 2rpx;
}

.notice .mark::after {
  content: "";
  position: absolute;
  left: 13rpx;
  bottom: 7rpx;
  width: 4rpx;
  height: 4rpx;
  background: #ffffff;
  border-radius: 50%;
}

.notice-err {
  background: var(--danger-soft);
  border: 2rpx solid var(--danger-line);
  color: var(--danger);
}
.notice-err .mark { background: var(--danger); }

.notice-warn {
  background: var(--warn-soft);
  color: var(--warn-ink);
}
.notice-warn .mark { background: var(--warn-ink); }

.notice-success {
  background: var(--spark-soft);
  border: 2rpx solid #eed8a8;
  color: #725318;
}

.notice-success .mark { background: var(--spark); }

/* ---------------------------------------------------------------- 标签 */

.tag {
  font-size: 24rpx;
  line-height: 1;
  padding: 8rpx 16rpx;
  border-radius: 40rpx;
  letter-spacing: 0.01em;
}

.tag-ai { background: var(--brand-soft); color: var(--brand); }
.tag-fail { background: var(--danger-soft); color: var(--danger); }

/* ---------------------------------------------------------------- 空态 */

.empty {
  background: var(--surface);
  border-radius: 24rpx;
  padding: 92rpx 56rpx 88rpx;
  text-align: center;
}

.empty-mark {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  margin: 0 auto 28rpx;
  display: block;
}

.empty .et {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: var(--ink);
}

.empty .ed {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.7;
  margin-top: 12rpx;
}

/* ---------------------------------------------------------------- 列表 */

.list {
  background: var(--surface);
  border-radius: 24rpx;
  overflow: hidden;
}

.row {
  min-height: 120rpx;
  padding: 30rpx 32rpx 28rpx;
  border-bottom: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.row-active {
  background: #f3f2ed;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-enter {
  flex: 0 0 auto;
  font-size: 26rpx;
  color: var(--brand);
}

.row:last-child { border-bottom: none; }

.row .body {
  font-size: 31rpx;
  line-height: 1.68;
  letter-spacing: 0.01em;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.row .meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 18rpx;
  font-size: 26rpx;
  color: var(--ink-3);
}

.row .meta .sep {
  width: 2rpx;
  height: 18rpx;
  background: var(--line-strong);
  margin: 0 20rpx;
}

/* ---------------------------------------------------------------- 页面标题行 */

.page-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

/* ---------------------------------------------------------------- 静态骨架加载 */

.skeleton-list {
  margin-top: 36rpx;
  padding: 0 32rpx;
  background: var(--surface);
  border-radius: 24rpx;
}

.skeleton-row {
  padding: 32rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.skeleton-row:last-child { border-bottom: none; }

.skeleton-line {
  height: 24rpx;
  border-radius: 10rpx;
  background: #eceae4;
}

.skeleton-line + .skeleton-line {
  margin-top: 20rpx;
  width: 44%;
  height: 18rpx;
}
