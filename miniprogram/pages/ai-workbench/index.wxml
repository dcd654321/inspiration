<view class="page ai-page {{enabled && !loadError && !completed ? 'has-footer' : ''}}" wx:if="{{ready}}">
  <view class="ai-heading">
    <text class="ai-stage">{{completed ? '已保存' : preview ? '核对与保存' : '选择素材'}}</text>
    <view class="page-title">{{title || 'AI 整理想法'}}</view>
    <view wx:if="{{!completed && !loadError}}" class="page-sub">{{preview ? '保留有用的部分，改成自己的表达。' : scope === 'expand' ? '从已有文字出发，梳理要点和下一步。' : '把相关内容收成一份可继续修改的文字。'}}</view>
  </view>
  <block wx:if="{{loadError}}">
    <view class="notice notice-err">{{error}}</view>
    <button class="btn btn-block" bindtap="onRetryLoad">重新读取</button>
    <button class="btn btn-quiet btn-block" bindtap="onBackToList">返回灵感列表</button>
  </block>
  <block wx:elif="{{!enabled}}">
    <view class="notice">暂时无法使用此功能</view>
    <button class="btn btn-quiet btn-block" bindtap="onBackToList">返回灵感列表</button>
  </block>
  <block wx:elif="{{completed}}">
    <view class="ai-complete"><view class="complete-title">{{notice}}</view><view class="hint">{{scope === 'expand' ? '原文保持原样，选中的内容已加入补充。' : mode === 'append' ? '所选来源继续保留，可随时查看。' : '汇总已保存，收起的来源可以恢复。'}}</view></view>
    <button class="btn btn-block" bindtap="onOpenSaved">查看已保存内容</button>
    <button class="btn btn-quiet btn-block" bindtap="onBackToList">返回灵感列表</button>
  </block>
  <block wx:elif="{{!preview}}">
    <view wx:if="{{original}}" class="source-panel">
      <view class="section-head"><text class="k">{{scope === 'expand' ? '这条灵感' : '所属灵感'}}</text></view>
      <view class="source-text {{originalExpanded ? '' : 'source-clamped'}}">{{original}}</view>
      <button wx:if="{{original.length > 140}}" class="btn-link" bindtap="onToggleOriginal" disabled="{{busy}}">{{originalExpanded ? '收起原文' : '展开原文'}}</button>
    </view>
    <view class="section-head source-heading"><text class="k">{{scope === 'expand' ? '参考补充 · 可不选' : scope === 'supplements' ? '选择需要汇总的补充' : '选择需要汇总的灵感'}}</text></view>
    <view class="hint" wx:if="{{options.length === 0}}">{{scope === 'expand' ? '可以直接根据这条灵感生成。' : '还没有足够的内容，可返回继续记录。'}}</view>
    <checkbox-group bindchange="onSelect"><label wx:for="{{options}}" wx:key="id" class="choice source-choice {{item.selected ? 'choice-selected' : ''}}"><checkbox value="{{item.id}}" checked="{{item.selected}}" disabled="{{busy}}" color="#34377f" /><text>{{item.content}}</text></label></checkbox-group>
    <view class="selection-status" aria-live="polite"><text>{{scope === 'expand' ? '已选补充' : '已选内容'}} {{selectedCount}} 条</text><text>{{sourceChars}} / 12000 字</text></view>
    <view wx:if="{{selectionHint}}" class="hint">{{selectionHint}}</view>
    <view class="privacy-note">{{scope === 'expand' ? '将原文与所选补充用于本次 AI 整理。' : '仅将所选文字用于本次 AI 整理。'}}照片和修改历史不参与。</view>
    <view wx:if="{{busyKind === 'generate'}}" class="notice" aria-live="polite">正在梳理内容，通常需要一些时间。请稍候。</view>
    <view wx:if="{{error}}" class="notice notice-err" aria-live="polite">{{error}}</view>
    <button wx:if="{{error}}" class="btn-link manual-link" bindtap="onManual" disabled="{{busy}}">先手动整理</button>
    <view class="ai-footer"><button class="btn btn-plain" bindtap="onBack" disabled="{{busy}}">返回</button><button class="btn" bindtap="onGenerate" disabled="{{busy || !canGenerate}}" loading="{{busyKind === 'generate'}}">{{busy ? '正在生成…' : error ? '重试生成' : '生成 AI 预览'}}</button></view>
  </block>
  <block wx:else>
    <view class="notice notice-warn">AI 生成内容可能不准确、遗漏或曲解原意，请核对后选择保存。</view>
    <view class="preview-note">预览尚未保存，离开后不会保留。</view>
    <checkbox-group wx:if="{{scope === 'expand'}}" bindchange="onEntrySelect">
      <block wx:for="{{entries}}" wx:key="id">
        <view wx:if="{{item.sectionStart}}" class="draft-section">{{item.label}}</view>
        <view class="draft-item {{item.selected ? '' : 'draft-unselected'}}">
          <label class="draft-check"><checkbox value="{{item.id}}" checked="{{item.selected}}" disabled="{{busy || saveUnknown}}" color="#34377f" /><text>保留这条{{item.label}}</text></label>
          <textarea value="{{item.content}}" data-id="{{item.id}}" bindinput="onEntryEdit" maxlength="200" auto-height disabled="{{busy || saveUnknown}}" cursor-spacing="24" aria-label="{{'编辑' + item.label + '第' + item.number + '条'}}" />
          <view class="entry-count">{{item.content.length}} / 200 字</view>
        </view>
      </block>
    </checkbox-group>
    <block wx:else>
      <view class="section-head source-heading"><text class="k">汇总正文</text><text class="v">{{summary.length}} / {{summarySaveMax}} 字</text></view>
      <view wx:if="{{acceptHint}}" class="notice notice-warn" aria-live="polite">{{acceptHint}}</view>
      <textarea class="summary-editor" value="{{summary}}" bindinput="onSummaryEdit" maxlength="-1" auto-height disabled="{{busy || saveUnknown}}" cursor-spacing="24" aria-label="编辑汇总内容" />
      <view class="draft-section">保存方式</view>
      <radio-group bindchange="onMode">
        <label class="choice mode-choice {{mode === 'append' ? 'choice-selected' : ''}}"><radio value="append" checked="{{mode === 'append'}}" disabled="{{busy || saveUnknown}}" color="#34377f" /><view class="choice-body"><text>{{scope === 'supplements' ? '新增一条补充' : '保存为新灵感'}}</text><text class="choice-help">所选来源继续保留</text></view></label>
        <label class="choice mode-choice {{mode === 'overwrite' ? 'choice-selected' : ''}}"><radio value="overwrite" checked="{{mode === 'overwrite'}}" disabled="{{busy || saveUnknown}}" color="#34377f" /><view class="choice-body"><text>{{scope === 'supplements' ? '汇总并收起补充' : '写入一条来源灵感'}}</text><text class="choice-help">收起的来源可恢复，保存前再次确认</text></view></label>
      </radio-group>
      <block wx:if="{{mode === 'overwrite' && scope === 'inspirations'}}"><view class="hint">请选择汇总写回的灵感。</view><radio-group bindchange="onTarget"><label wx:for="{{targets}}" wx:key="id" class="choice"><radio value="{{item.id}}" checked="{{targetId === item.id}}" disabled="{{busy || saveUnknown}}" color="#34377f" /><text>{{item.label}}</text></label></radio-group></block>
    </block>
    <view wx:if="{{scope === 'expand'}}" class="selection-status" aria-live="polite"><text>已选 {{acceptedCount}} / {{entries.length}} 条</text><text>保存后加入补充</text></view>
    <view wx:if="{{error}}" class="notice {{saveUnknown ? 'notice-warn' : 'notice-err'}}" aria-live="polite">{{error}}</view>
    <view wx:if="{{notice}}" class="notice" aria-live="polite">{{notice}}</view>
    <view wx:if="{{busyKind === 'save'}}" class="notice" aria-live="polite">正在保存，请稍候。</view>
    <button class="btn-link change-sources" bindtap="onDiscard" disabled="{{busy}}">重新选择素材</button><button class="btn-link" bindtap="onBack" disabled="{{busy}}">返回</button>
    <view class="ai-footer"><button class="btn btn-plain" bindtap="onCopy" disabled="{{busy}}">复制{{scope === 'expand' ? '所选' : '正文'}}</button><button class="btn" bindtap="onAccept" disabled="{{busy || !canAccept}}" loading="{{busyKind === 'save'}}">{{busyKind === 'save' ? '正在保存…' : saveUnknown ? '重试确认保存' : scope === 'expand' ? '保存所选 ' + acceptedCount + ' 条' : '确认保存'}}</button></view>
  </block>
</view>
<view class="page" wx:else><view class="hint">正在读取素材…</view></view>
