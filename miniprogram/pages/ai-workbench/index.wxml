<view class="page" wx:if="{{ready}}">
  <view class="page-title">{{title || '整理想法'}}</view>
  <view wx:if="{{!enabled}}" class="notice">AI 整理尚未开放，记录和手动整理仍可使用。</view>
  <block wx:elif="{{completed}}"><view class="hint">已完成本次整理。</view></block>
  <block wx:elif="{{!preview}}">
    <view wx:if="{{original}}" class="source-text">{{original}}</view>
    <view class="hint">{{scope === 'expand' ? '选择需要参考的补充，可不选。' : '选择 2 至 20 条相关内容。'}}</view>
    <checkbox-group bindchange="onSelect">
      <label wx:for="{{options}}" wx:key="id" class="choice">
        <checkbox value="{{item.id}}" checked="{{item.selected}}" disabled="{{busy}}" color="#34377f" /><text>{{item.content}}</text>
      </label>
    </checkbox-group>
    <view class="hint">仅将所选文字用于本次 AI 整理，不包含照片或修改历史。</view>
    <button class="btn btn-block" bindtap="onGenerate" disabled="{{busy}}" loading="{{busy}}">{{busy ? '正在生成…' : '生成预览'}}</button>
  </block>
  <block wx:else>
    <view class="notice notice-warn">AI 生成内容可能不准确、遗漏或曲解原意，请核对后选择保存。</view>
    <checkbox-group wx:if="{{scope === 'expand'}}" bindchange="onEntrySelect">
      <view wx:for="{{entries}}" wx:key="id" class="draft-item">
        <label><checkbox value="{{item.id}}" checked="{{item.selected}}" color="#34377f" />{{item.label}}</label>
        <textarea value="{{item.content}}" data-id="{{item.id}}" bindinput="onEntryEdit" maxlength="200" auto-height aria-label="编辑生成内容" />
      </view>
    </checkbox-group>
    <block wx:else>
      <textarea class="summary-editor" value="{{summary}}" bindinput="onSummaryEdit" maxlength="2000" auto-height aria-label="编辑汇总内容" />
      <radio-group bindchange="onMode">
        <label class="choice"><radio value="append" checked="{{mode === 'append'}}" color="#34377f" /><text>{{scope === 'supplements' ? '新增补充' : '保存为新灵感'}}，来源继续保留</text></label>
        <label class="choice"><radio value="overwrite" checked="{{mode === 'overwrite'}}" color="#34377f" /><text>{{scope === 'supplements' ? '覆盖补充' : '覆盖灵感'}}，来源收起并可恢复</text></label>
      </radio-group>
      <block wx:if="{{mode === 'overwrite' && scope === 'inspirations'}}">
        <view class="hint">请选择汇总写回的灵感，其余来源将收起。</view>
        <radio-group bindchange="onTarget"><label wx:for="{{targets}}" wx:key="id" class="choice"><radio value="{{item.id}}" checked="{{targetId === item.id}}" color="#34377f" /><text>{{item.label}}</text></label></radio-group>
      </block>
    </block>
    <button class="btn btn-block" bindtap="onAccept" disabled="{{busy}}" loading="{{busy}}">确认保存</button>
    <button class="btn btn-plain btn-block" bindtap="onDiscard" disabled="{{busy}}">放弃本次结果</button>
  </block>
  <view wx:if="{{error}}" class="notice notice-err">{{error}}</view>
  <view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <button class="btn btn-plain btn-block" bindtap="onBack" disabled="{{busy}}">返回</button>
</view>
