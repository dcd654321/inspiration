.has-footer { padding-bottom: calc(240rpx + env(safe-area-inset-bottom)); }
.ai-stage { display: block; margin-bottom: 12rpx; font-size: max(24rpx, 13px); color: var(--brand); letter-spacing: .04em; }
.ai-heading { margin-bottom: 32rpx; }
.source-panel { padding: 28rpx; border-left: 4rpx solid var(--brand-line); background: #fff; border-radius: 0 16rpx 16rpx 0; }
.source-text { white-space: pre-wrap; word-break: break-all; font-size: max(30rpx, 16px); line-height: 1.8; }
.source-clamped { display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; }
.source-heading { margin: 32rpx 0 16rpx; }
.hint, .privacy-note, .preview-note { margin: 20rpx 0; color: var(--ink-2); font-size: max(26rpx, 13px); line-height: 1.7; }
.privacy-note { padding-top: 20rpx; border-top: 1rpx solid var(--line); }
.choice { display: flex; align-items: flex-start; gap: 16rpx; min-height: max(88rpx, 44px); box-sizing: border-box; padding: 24rpx 20rpx; margin: 16rpx 0; border: 2rpx solid var(--line-strong); border-radius: 16rpx; background: #fff; }
.choice text, .choice-body { flex: 1; min-width: 0; white-space: pre-wrap; word-break: break-all; font-size: max(30rpx, 16px); line-height: 1.7; }
.choice checkbox, .choice radio { flex: 0 0 auto; margin-top: 4rpx; }
.choice-selected { border-color: var(--brand); background: var(--brand-soft); }
.choice-body text { display: block; }
.choice-body .choice-help { margin-top: 6rpx; font-size: max(26rpx, 13px); color: var(--ink-2); }
.selection-status { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12rpx; padding: 20rpx 0; font-size: max(26rpx, 13px); color: var(--ink-2); }
.draft-section { font-size: max(30rpx, 16px); font-weight: 600; margin: 36rpx 0 16rpx; }
.draft-item { padding: 24rpx; margin: 16rpx 0; border: 2rpx dashed var(--brand-line); border-radius: 20rpx; background: #fff; }
.draft-unselected { background: transparent; }
.draft-check { display: flex; align-items: center; gap: 12rpx; min-height: 44px; font-size: max(26rpx, 14px); color: var(--ink-2); }
.draft-item textarea, .summary-editor { width: 100%; box-sizing: border-box; min-height: 100rpx; margin-top: 12rpx; padding: 12rpx 0; font-size: max(30rpx, 16px); line-height: 1.8; }
.entry-count { margin-top: 8rpx; text-align: right; font-size: max(24rpx, 13px); color: var(--ink-3); }
.summary-editor { padding: 28rpx; min-height: 260rpx; background: #fff; border: 2rpx dashed var(--brand-line); border-radius: 20rpx; }
.ai-footer { position: fixed; left: 0; right: 0; bottom: 0; z-index: 8; display: flex; align-items: center; gap: 16rpx; padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--line-strong); background: var(--paper); }
.ai-footer .btn { flex: 2 1 0; padding: 0 16rpx; min-width: 0; font-size: max(28rpx, 14px); line-height: 1.4; }
.ai-footer .btn-plain { flex: 1 1 0; }
.ai-complete { margin: 40rpx 0; padding: 32rpx; background: var(--brand-soft); border-radius: 20rpx; }
.complete-title { color: var(--brand); font-size: max(34rpx, 18px); font-weight: 600; }
.btn-block { margin-top: 24rpx; }
.change-sources { margin-top: 24rpx; }
