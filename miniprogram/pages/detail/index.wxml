<view class="page" wx:if="{{ready}}">
  <block wx:if="{{missing}}">
    <view class="empty">
      <view class="et">找不到这条灵感</view>
      <view class="ed">{{error || '这条灵感不存在或已经删除。'}}</view>
    </view>
    <button class="btn btn-plain btn-block" style="margin-top: 32rpx" bindtap="onBackToList">返回灵感列表</button>
  </block>

  <block wx:else>
    <view class="stamp">{{time}}</view>

    <!-- 原文：可以直接编辑。不放进卡片，字号最大——它是锚点 -->
    <view class="origin">
      <block wx:if="{{editing}}">
        <textarea
          class="origin-editor"
          value="{{editDraft}}"
          maxlength="{{textMax}}"
          auto-height
          bindinput="onEditInput"
        />
        <view class="origin-acts">
          <button class="btn btn-sm" bindtap="onSaveEdit" disabled="{{!canSaveEdit || pending !== ''}}">{{pending === 'text' ? '保存中…' : '保存'}}</button>
          <button class="btn btn-plain btn-sm" bindtap="onCancelEdit" disabled="{{pending !== ''}}">取消</button>
        </view>
        <view wx:if="{{editError}}" class="notice notice-err">
          <view class="mark"></view>
          <text>{{editError}}</text>
        </view>
      </block>

      <block wx:else>
        <view class="origin-text">{{text}}</view>
        <view class="origin-acts">
          <button class="btn btn-quiet btn-sm" bindtap="onStartEdit">修改内容</button>
          <button
            wx:if="{{historyCount > 0}}"
            class="btn btn-plain btn-sm"
            bindtap="onOpenHistory"
          >查看修改记录（{{historyCount}}）</button>
        </view>
      </block>
    </view>

    <!-- 补充是详情页的主动作：进入页面即可看到，不必越过时间线。 -->
    <view wx:if="{{!editing}}" class="detail-next">
      <view class="section-head"><text class="k">继续补充</text></view>
      <view class="compose">
        <textarea
          class="compose-editor"
          value="{{supplementDraft}}"
          maxlength="{{supplementMax}}"
          placeholder="为这条想法补充内容"
          placeholder-class="compose-ph"
          auto-height
          bindinput="onSupplementInput"
        />
        <view class="compose-foot">
          <text class="count">{{supplementDraft.length}} / {{supplementMax}}</text>
          <button
            class="btn btn-sm"
            bindtap="onSubmitSupplement"
            disabled="{{!canAddSupplement || pending !== ''}}"
          >{{pending === 'supplement' ? '添加中…' : '添加补充'}}</button>
        </view>

        <view wx:if="{{supplementError}}" class="notice notice-err">
          <view class="mark"></view>
          <text>{{supplementError}}</text>
        </view>
      </view>

      <view class="output-acts">
        <button class="btn btn-quiet btn-sm" bindtap="onOpenOutput">整理内容</button>
        <button class="btn btn-plain btn-sm" bindtap="onCopyContent">复制内容</button>
        <button class="btn btn-plain btn-sm" bindtap="onOpenShare">分享文字</button>
      </view>
    </view>

    <view class="divider"></view>

    <!-- 补充时间线：按时间正序。点「更多」或长按均可打开操作面板 -->
    <view class="section-head" style="margin-top: 36rpx">
      <text class="k">补充</text>
      <text class="v">{{supplements.length}} 条</text>
    </view>

    <view wx:if="{{supplements.length === 0 && hidden.length === 0}}" class="hint-line">还没有补充</view>

    <view wx:else class="timeline">
      <block wx:for="{{supplements}}" wx:key="id">
        <view
          class="tl-item {{item.isAi ? 'tl-ai' : ''}}"
          data-id="{{item.id}}"
          bindlongpress="onSupplementLongPress"
        >
          <view class="tl-when">
            <view class="tl-meta">
              <text>{{item.time}}</text>
              <text wx:if="{{item.isAi}}" class="tag tag-ai">AI 生成 · 请核对</text>
            </view>
            <button class="tl-more" data-id="{{item.id}}" aria-label="打开补充操作" catchtap="onSupplementAction">更多</button>
          </view>

          <!-- 行内修改：旧内容会留在历史里 -->
          <block wx:if="{{editingSupplementId === item.id}}">
            <textarea
              class="tl-editor"
              value="{{supplementEditDraft}}"
              maxlength="{{supplementMax}}"
              auto-height
              bindinput="onSupplementEditInput"
            />
            <view class="tl-acts">
              <button class="btn btn-sm" bindtap="onSupplementEditSave" disabled="{{!canSaveSupplementEdit || pending !== ''}}">{{pending === 'supplementEdit' ? '保存中…' : '保存'}}</button>
              <button class="btn btn-plain btn-sm" bindtap="onSupplementEditCancel" disabled="{{pending !== ''}}">取消</button>
            </view>
            <view wx:if="{{supplementEditError}}" class="notice notice-err">
              <view class="mark"></view>
              <text>{{supplementEditError}}</text>
            </view>
          </block>

          <view wx:else class="tl-what">{{item.content}}</view>
        </view>
      </block>

      <!--
        已收起的补充。**必须能展开、能恢复**——默认隐藏 + 没有入口 = 删除，
        而规范明确要求它们可查看、可恢复。
      -->
      <view wx:if="{{hidden.length > 0}}" class="hidden-block">
        <button class="hidden-row" bindtap="onToggleHidden">
          <text>{{hidden.length}} 条{{hidden[0].hiddenLabel}} · {{hiddenExpanded ? '收起' : '展开'}}</text>
        </button>

        <block wx:if="{{hiddenExpanded}}">
          <view
            wx:for="{{hidden}}"
            wx:key="id"
            class="tl-item tl-hidden"
            data-id="{{item.id}}"
            bindlongpress="onSupplementLongPress"
          >
            <view class="tl-when">
              <view class="tl-meta">
                <text>{{item.time}}</text>
                <text class="tag tag-ai">{{item.hiddenLabel}}</text>
              </view>
              <button class="tl-more" data-id="{{item.id}}" aria-label="打开已收起补充操作" catchtap="onSupplementAction">操作</button>
            </view>
            <view class="tl-what">{{item.content}}</view>
            <view class="tl-hint">可恢复为普通补充，或永久删除</view>
          </view>
        </block>
      </view>
    </view>

    <view wx:if="{{error}}" class="notice notice-err">
      <view class="mark"></view>
      <text>{{error}}</text>
    </view>

    <view style="margin-top: 48rpx">
      <button class="btn btn-danger btn-block" bindtap="onDelete" disabled="{{pending !== ''}}">{{pending === 'deleteInspiration' ? '删除中…' : '删除灵感'}}</button>
    </view>
  </block>

  <!-- 补充操作面板：可由「更多」或长按打开 -->
  <view wx:if="{{sheetVisible}}" class="mask" bindtap="onSheetDismiss">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">{{sheetTargetLabel}}</view>

      <button class="sheet-item" bindtap="onSheetCopy" disabled="{{pending !== ''}}">复制这条</button>

      <block wx:if="{{sheetIsHidden}}">
        <button class="sheet-item" bindtap="onSheetRestore" disabled="{{pending !== ''}}">恢复<text class="sub">恢复为普通补充</text></button>
      </block>
      <block wx:else>
        <button class="sheet-item" bindtap="onSheetEdit" disabled="{{pending !== ''}}">修改<text class="sub">旧内容会保留在修改记录中</text></button>
        <button class="sheet-item" bindtap="onSheetFold" disabled="{{pending !== ''}}">并入正文<text class="sub">把这条补充追加到正文末尾</text></button>
      </block>

      <button class="sheet-item sheet-danger" bindtap="onSheetDelete" disabled="{{pending !== ''}}">删除<text class="sub">此操作无法撤销</text></button>
      <button class="sheet-cancel" bindtap="onSheetDismiss" disabled="{{pending !== ''}}">取消</button>
    </view>
  </view>

  <!-- 删除确认。整个产品里唯一不可恢复的操作，不能一次点击就生效 -->
  <view wx:if="{{confirmVisible}}" class="mask mask-center">
    <view class="dialog">
      <view class="dialog-title">删除补充</view>
      <view class="dialog-body">确定移除这条补充吗？<text class="dialog-warn">此操作无法撤销</text>。</view>
      <view class="dialog-quote">
        <view class="dialog-quote-t">{{confirmQuote}}</view>
        <view class="dialog-quote-m">{{confirmQuoteTime}}</view>
      </view>
      <view class="dialog-acts">
        <button class="dialog-act" bindtap="onConfirmDismiss" disabled="{{pending !== ''}}">取消</button>
        <button class="dialog-act dialog-act-danger" bindtap="onConfirmDelete" disabled="{{pending !== ''}}">{{pending === 'deleteSupplement' ? '删除中…' : '删除'}}</button>
      </view>
    </view>
  </view>
</view>
