.stamp {
  font-size: 24rpx;
  color: var(--ink-3);
  padding-bottom: 20rpx;
}

/* ---------------------------------------------------------------- 原文：锚点 */

.origin {
  padding-bottom: 44rpx;
}

.origin-text,
.origin-editor {
  width: 100%;
  font-size: 38rpx;
  line-height: 1.78;
  letter-spacing: 0.012em;
  color: var(--ink);
}

.origin-acts {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 36rpx;
}

/* ---------------------------------------------------------------- 补充时间线 */

.hint-line {
  font-size: 28rpx;
  color: var(--ink-3);
  padding: 20rpx 0;
}

.timeline {
  position: relative;
}

.tl-item {
  position: relative;
  padding: 28rpx 0 28rpx 40rpx;
}

/* 圆点。用 box-shadow 在外圈垫一圈底色，让竖线看起来是从圆点后面穿过的 */
.tl-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 42rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #cdcdd8;
  box-shadow: 0 0 0 6rpx var(--paper);
  z-index: 1;
}

.tl-ai::before {
  background: var(--brand);
}

/* 竖线。最后一条不画，避免尾巴拖出半截 */
.tl-item:not(:last-child)::after {
  content: "";
  position: absolute;
  left: 6rpx;
  top: 52rpx;
  bottom: -4rpx;
  width: 2rpx;
  background: var(--line);
}

.tl-when {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  font-size: 25rpx;
  color: var(--ink-3);
  margin-bottom: 10rpx;
}

.output-acts {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 24rpx 0 40rpx;
}

.output-acts .btn {
  width: calc(50% - 8rpx);
  flex: 0 0 calc(50% - 8rpx);
  margin: 0;
  box-sizing: border-box;
}

.origin-acts .btn, .tl-acts .btn, .compose-foot .btn {
  width: auto;
  margin: 0;
}

.detail-next .section-head {
  margin-bottom: 12rpx;
}

.tl-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  min-width: 0;
}

.tl-more {
  flex: 0 0 auto;
  min-width: 88rpx;
  min-height: 88rpx;
  margin: -20rpx -20rpx -20rpx 0;
  padding: 0 20rpx;
  border: none;
  background: transparent;
  color: var(--brand);
  font-size: 25rpx;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.tl-more::after { border: none; }

.tl-what {
  font-size: 29rpx;
  line-height: 1.72;
  letter-spacing: 0.01em;
}

/* ---------------------------------------------------------------- 追加补充 */

.compose {
  background: var(--surface);
  border-radius: 20rpx;
  padding: 24rpx 26rpx 22rpx;
}

.compose-editor {
  width: 100%;
  min-height: 88rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--ink);
}

.compose-ph {
  color: var(--ink-3);
}

.compose-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.count {
  font-size: 24rpx;
  color: var(--ink-3);
}

/* ---------------------------------------------------------------- 补充的行内修改 */

.tl-editor {
  width: 100%;
  min-height: 80rpx;
  font-size: 29rpx;
  line-height: 1.72;
  color: var(--ink);
}

.tl-acts {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* ---------------------------------------------------------------- 已收起的补充 */

.hidden-block {
  margin-top: 12rpx;
}

.hidden-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 14rpx 0;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--ink-2);
  background: transparent;
  border-radius: 0;
  border-bottom: 2rpx dashed var(--line-strong);
}

.hidden-row::after { border: none; }

.tl-hidden {
  opacity: 0.72;
}

.tl-hint {
  font-size: 25rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
}

/* ---------------------------------------------------------------- 遮罩与面板 */

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(22, 22, 29, 0.42);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.mask-center {
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}

/* 补充操作面板 */
.sheet {
  width: 100%;
  background: var(--surface);
  border-radius: 32rpx 32rpx 0 0;
  padding: 12rpx 0 24rpx;
}

.sheet-title {
  font-size: 24rpx;
  color: var(--ink-3);
  text-align: center;
  padding: 24rpx 40rpx 20rpx;
  border-bottom: 2rpx solid var(--line);
}

.sheet-item {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 30rpx 40rpx;
  font-size: 32rpx;
  line-height: 1.4;
  width: 100%;
  margin: 0;
  background: var(--surface);
  border-radius: 0;
  letter-spacing: 0.01em;
  border-bottom: 2rpx solid var(--line);
}

.sheet-item::after { border: none; }

.sheet-item .sub {
  font-size: 26rpx;
  color: var(--ink-3);
}

/* 删除用危险色，并且和另外两项在视觉上分开 */
.sheet-danger {
  color: var(--danger);
}

.sheet-danger .sub {
  color: #d29b95;
}

.sheet-cancel {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 28rpx 0;
  min-height: 88rpx;
  padding: 0;
  width: calc(100% - 56rpx);
  border: none;
  text-align: center;
  font-size: 32rpx;
  line-height: 1;
  color: var(--ink-2);
  background: #f2f2f6;
  border-radius: 16rpx;
}

.sheet-cancel::after { border: none; }

/* 删除确认 */
.dialog {
  width: 100%;
  background: var(--surface);
  border-radius: 28rpx;
  overflow: hidden;
  text-align: center;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  padding: 40rpx 40rpx 16rpx;
  letter-spacing: -0.01em;
}

.dialog-body {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.7;
  padding: 0 40rpx 28rpx;
}

.dialog-warn {
  color: var(--danger);
  font-weight: 600;
}

/* 待删内容放进一个带时间的框——让「要删的就是这条」连起来，不是两句不相干的话 */
.dialog-quote {
  margin: 0 40rpx 36rpx;
  padding: 22rpx 26rpx;
  background: var(--paper);
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  text-align: left;
}

.dialog-quote-t {
  font-size: 27rpx;
  line-height: 1.65;
  color: var(--ink);
}

.dialog-quote-m {
  font-size: 23rpx;
  color: var(--ink-3);
  margin-top: 12rpx;
}

.dialog-acts {
  display: flex;
  border-top: 2rpx solid var(--line);
}

.dialog-act {
  flex: 1;
  min-height: 96rpx;
  padding: 0;
  font-size: 32rpx;
  line-height: 1;
  margin: 0;
  border: none;
  border-radius: 0;
  background: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog-act::after { border: none; }

.dialog-act + .dialog-act {
  border-left: 2rpx solid var(--line);
}

.dialog-act-danger {
  color: var(--danger);
  font-weight: 500;
}

.sheet-item[disabled],
.sheet-cancel[disabled],
.dialog-act[disabled],
.tl-more[disabled] {
  opacity: 0.55;
}

.organization { margin: 28rpx 0; padding: 24rpx; border: 1rpx solid #e1e5dc; border-radius: 20rpx; }
.organization input, .stage-picker { min-height: 88rpx; line-height: 88rpx; font-size: 28rpx; }
.source-link { text-align: left; white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.7; padding: 20rpx 0; }
.photo-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 20rpx 0; }
.photo-cell { width: 30%; }
.photo-cell image { width: 100%; height: 190rpx; border-radius: 16rpx; background: #eef0ea; }
.photos-section { margin: 36rpx 0; }
.source-trace { padding: 20rpx; border-left: 3rpx solid #b8c8ad; white-space: pre-wrap; font-size: 27rpx; line-height: 1.8; }
.source-trace view + view { margin-top: 24rpx; }
