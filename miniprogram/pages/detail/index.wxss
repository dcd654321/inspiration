.stamp {
  font-size: 24rpx;
  color: var(--ink-3);
  padding-bottom: 20rpx;
}

/* ---------------------------------------------------------------- 原文：锚点 */

.origin {
  padding-bottom: 44rpx;
}

.origin-text,
.origin-editor {
  width: 100%;
  font-size: 38rpx;
  line-height: 1.78;
  letter-spacing: 0.012em;
  color: var(--ink);
}

.origin-acts {
  display: flex;
  gap: 16rpx;
  margin-top: 36rpx;
}

/* ---------------------------------------------------------------- 补充时间线 */

.hint-line {
  font-size: 28rpx;
  color: var(--ink-3);
  padding: 20rpx 0;
}

.timeline {
  position: relative;
}

.tl-item {
  position: relative;
  padding: 28rpx 0 28rpx 40rpx;
}

/* 圆点。用 box-shadow 在外圈垫一圈底色，让竖线看起来是从圆点后面穿过的 */
.tl-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 42rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #cdcdd8;
  box-shadow: 0 0 0 6rpx var(--paper);
  z-index: 1;
}

.tl-ai::before {
  background: var(--brand);
}

/* 竖线。最后一条不画，避免尾巴拖出半截 */
.tl-item:not(:last-child)::after {
  content: "";
  position: absolute;
  left: 6rpx;
  top: 52rpx;
  bottom: -4rpx;
  width: 2rpx;
  background: var(--line);
}

.tl-when {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 23rpx;
  color: var(--ink-3);
  margin-bottom: 10rpx;
}

.tl-what {
  font-size: 29rpx;
  line-height: 1.72;
  letter-spacing: 0.01em;
}

/* ---------------------------------------------------------------- 追加补充 */

.compose {
  margin-top: 12rpx;
  background: var(--surface);
  border-radius: 20rpx;
  padding: 24rpx 26rpx 22rpx;
}

.compose-editor {
  width: 100%;
  min-height: 88rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--ink);
}

.compose-ph {
  color: var(--ink-3);
}

.compose-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.count {
  font-size: 24rpx;
  color: var(--ink-3);
}

/* ---------------------------------------------------------------- 未开放的能力 */

/* 只说明，不给入口——也不展示任何看起来像结果的内容 */
.closed-note {
  padding: 30rpx 32rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: var(--ink-2);
}

/* ---------------------------------------------------------------- 补充的行内修改 */

.tl-editor {
  width: 100%;
  min-height: 80rpx;
  font-size: 29rpx;
  line-height: 1.72;
  color: var(--ink);
}

.tl-acts {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* ---------------------------------------------------------------- 已收起的补充 */

.hidden-block {
  margin-top: 12rpx;
}

.hidden-row {
  display: inline-flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--ink-2);
  padding: 14rpx 0;
  border-bottom: 2rpx dashed var(--line-strong);
}

.tl-hidden {
  opacity: 0.72;
}

.tl-hint {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
}

/* ---------------------------------------------------------------- 遮罩与面板 */

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(22, 22, 29, 0.42);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.mask-center {
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}

/* 长按操作面板 */
.sheet {
  width: 100%;
  background: var(--surface);
  border-radius: 32rpx 32rpx 0 0;
  padding: 12rpx 0 24rpx;
}

.sheet-title {
  font-size: 24rpx;
  color: var(--ink-3);
  text-align: center;
  padding: 24rpx 40rpx 20rpx;
  border-bottom: 2rpx solid var(--line);
}

.sheet-item {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 30rpx 40rpx;
  font-size: 32rpx;
  letter-spacing: 0.01em;
  border-bottom: 2rpx solid var(--line);
}

.sheet-item .sub {
  font-size: 24rpx;
  color: var(--ink-3);
}

/* 长按是容易误触的手势：删除用危险色，并且和另外两项在视觉上分开 */
.sheet-danger {
  color: var(--danger);
}

.sheet-danger .sub {
  color: #d29b95;
}

.sheet-cancel {
  margin: 20rpx 28rpx 0;
  padding: 26rpx 0;
  text-align: center;
  font-size: 32rpx;
  color: var(--ink-2);
  background: #f2f2f6;
  border-radius: 16rpx;
}

/* 删除确认 */
.dialog {
  width: 100%;
  background: var(--surface);
  border-radius: 28rpx;
  overflow: hidden;
  text-align: center;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  padding: 40rpx 40rpx 16rpx;
  letter-spacing: -0.01em;
}

.dialog-body {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.7;
  padding: 0 40rpx 28rpx;
}

.dialog-warn {
  color: var(--danger);
  font-weight: 600;
}

/* 待删内容放进一个带时间的框——让「要删的就是这条」连起来，不是两句不相干的话 */
.dialog-quote {
  margin: 0 40rpx 36rpx;
  padding: 22rpx 26rpx;
  background: var(--paper);
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  text-align: left;
}

.dialog-quote-t {
  font-size: 27rpx;
  line-height: 1.65;
  color: var(--ink);
}

.dialog-quote-m {
  font-size: 23rpx;
  color: var(--ink-3);
  margin-top: 12rpx;
}

.dialog-acts {
  display: flex;
  border-top: 2rpx solid var(--line);
}

.dialog-act {
  flex: 1;
  padding: 30rpx 0;
  font-size: 32rpx;
}

.dialog-act + .dialog-act {
  border-left: 2rpx solid var(--line);
}

.dialog-act-danger {
  color: var(--danger);
  font-weight: 500;
}

