@import "../../styles/todo-entry.wxss";

/* 顶部：时间与低频操作的入口。低频操作全部收进「更多」，正文上方保持安静 */
.detail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.detail-head .stamp {
  font-size: 12px;
  color: var(--ink-3);
  padding-bottom: 0;
}

.detail-more {
  flex: 0 0 auto;
  min-width: 88rpx;
  min-height: 88rpx;
  margin: -8px -10px -8px 0;
  padding: 0 10px;
  border: none;
  background: transparent;
  color: var(--brand);
  font-size: 14px;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.detail-more::after { border: none; }

.detail-more[disabled] { opacity: 0.55; }

.archive-state {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 16rpx 0;
  color: var(--ink-3);
  font-size: max(26rpx, 13px);
  line-height: 1.6;
}

.archive-organization {
  padding: 16rpx 0;
  color: var(--ink-2);
  font-size: max(28rpx, 14px);
  line-height: 1.7;
}

/* 轻量动作：两个主任务的入口，等宽一行 */
.detail-actions {
  display: flex;
  gap: 8px;
  margin: 18px 0 8px;
}

.compose .field-label { margin-bottom: 12rpx; }

.detail-actions .btn {
  flex: 1 1 0;
  min-width: 0;
  margin: 0;
  padding: 0 12rpx;
  box-sizing: border-box;
}

/* ---------------------------------------------------------------- 原文：锚点 */

.origin {
  padding-bottom: 8rpx;
}

/* A 清晰轻页：正文与编辑器共用系统无衬线，以行距和分隔建立层级。 */
.origin-text,
.origin-editor {
  width: 100%;
  font-size: 17px;
  line-height: 1.9;
  letter-spacing: 0;
  color: var(--ink);
  font-family: inherit;
}

.origin-acts {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 36rpx;
}

/* ---------------------------------------------------------------- 补充时间线 */

.hint-line {
  font-size: 13px;
  color: var(--ink-3);
  padding: 10px 0;
}

.timeline {
  position: relative;
}

.tl-item {
  position: relative;
  padding: 16px 0;
  border-bottom: 1px solid var(--line);
}

.tl-when {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  font-size: 12px;
  color: var(--ink-3);
  margin-bottom: 10rpx;
}

/* 一行三个等宽。之前固定两列，按钮数为奇数时最后一个独占半行、左对齐，看着像漏了一个。 */
.output-acts {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0 0;
}

.output-acts .btn {
  flex: 1 1 0;
  min-width: 0;
  margin: 0;
  padding: 0 12rpx;
  box-sizing: border-box;
}


.origin-acts .btn, .tl-acts .btn, .compose-foot .btn {
  width: auto;
  margin: 0;
}

.detail-next { margin-bottom: 40rpx; }

.detail-next .section-head {
  margin-bottom: 12rpx;
}

.tl-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  min-width: 0;
}

.tl-more {
  flex: 0 0 auto;
  min-width: 88rpx;
  min-height: 88rpx;
  margin: -20rpx -20rpx -20rpx 0;
  padding: 0 20rpx;
  border: none;
  background: transparent;
  color: var(--brand);
  font-size: 25rpx;
  font-size: max(25rpx, 14px);
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.tl-more::after { border: none; }

.tl-what {
  font-size: 16px;
  line-height: 1.8;
  letter-spacing: 0;
}

/* ---------------------------------------------------------------- 追加补充 */

.compose {
  background: var(--surface);
  border-radius: 0;
  padding: 18px 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

/* 补充输入器固定两档：空且未聚焦 80px，聚焦或已有内容 160px。
   **关闭 auto-height**——固定高度与自动增高同时存在会互相打架。
   多余文字在输入框内部滚动；px 兜底避免 320 宽时缩得过小。 */
.compose-editor {
  box-sizing: border-box;
  width: 100%;
  height: 160px;
  padding: 12px;
  border: 1px solid var(--field-line);
  border-radius: 8px;
  font-size: 16px;
  line-height: 1.8;
  color: var(--ink);
}

.compose-editor.compose-tall {
  height: 160px;
}

.count-over {
  color: var(--danger);
}

.hint-over {
  font-size: 24rpx;
  font-size: max(24rpx, 13px);
  color: var(--danger);
  margin-top: 12rpx;
}

.compose-ph {
  color: var(--ink-3);
}

.compose-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.count {
  font-size: 24rpx;
  font-size: max(24rpx, 13px);
  color: var(--ink-3);
}

/* ---------------------------------------------------------------- 补充的行内修改 */

.tl-editor {
  width: 100%;
  min-height: 80rpx;
  font-size: 29rpx;
  font-size: max(29rpx, 16px);
  line-height: 1.72;
  color: var(--ink);
}

.tl-acts {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* ---------------------------------------------------------------- 已收起的补充 */

.hidden-block {
  margin-top: 12rpx;
}

.hidden-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 14rpx 0;
  font-size: 26rpx;
  font-size: max(26rpx, 13px);
  line-height: 1.5;
  color: var(--ink-2);
  background: transparent;
  border-radius: 0;
  border-bottom: 2rpx dashed var(--line-strong);
}

.hidden-row::after { border: none; }

.tl-hidden {
  opacity: 0.72;
}

.tl-hint {
  font-size: 25rpx;
  font-size: max(25rpx, 13px);
  color: var(--ink-3);
  margin-top: 8rpx;
}

/* ---------------------------------------------------------------- 整理标记 */

.organization { margin: 16px 0; padding: 12px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
/* 收起行：左边是当前状态摘要，右边是动作词。表单只在真要改时摊开 */
.org-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 88rpx;
}
.org-value { flex: 1; min-width: 0; font-size: max(28rpx, 14px); line-height: 1.5; color: var(--ink-2); }
.org-toggle { flex: 0 0 auto; font-size: max(27rpx, 14px); color: var(--brand); }
/* 可编辑字段必须有看得见的输入边界。
   标签输入框原来是裸 input，在卡片里和一行说明文字长得一模一样，没人知道它能改。 */
.organization input,
.organization .stage-picker {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  font-size: max(28rpx, 16px);
  line-height: 88rpx;
  color: var(--ink);
  background: var(--paper);
  border: 1px solid var(--field-line);
  border-radius: 16rpx;
}
.organization .stage-picker { display: flex; align-items: center; }
/* 标记表单的动作行：保存标记 / 取消，取消恢复进入前的值 */
.org-acts { display: flex; gap: 16rpx; margin-top: 24rpx; }
.org-acts .btn { width: auto; margin: 0; }

/* 长正文的定位入口：滚离原文后出现，落在右下角，不遮挡时间线的阅读；
   不用投影——层级仍靠实心底色区分 */
.float-supplement {
  position: fixed;
  right: 40rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  min-height: 88rpx;
  padding: 0 36rpx;
  border: none;
  border-radius: 44rpx;
  background: var(--brand);
  color: #ffffff;
  font-size: 28rpx;
  font-size: max(28rpx, 14px);
  line-height: 1;
  display: inline-flex;
  align-items: center;
  z-index: 50;
}

.float-supplement::after { border: none; }
.source-link { text-align: left; white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.7; padding: 20rpx 0; }
.photo-strip { width: 100%; white-space: nowrap; margin-top: 16rpx; }
.photo-cell { display: inline-block; width: 84px; margin-right: 8px; vertical-align: top; white-space: normal; }
.photo-cell:last-child { margin-right: 0; }
.photo-preview { box-sizing: border-box; width: 84px; height: 84px; border-radius: 8px; background: var(--brand-soft); }
.photo-retry, .photo-loading { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 12rpx; margin: 0; border: 1px solid var(--field-line); font-size: max(24rpx, 13px); line-height: 1.5; color: var(--ink-2); }
.photo-retry text { margin-top: 8rpx; color: var(--brand); }
.photo-retry::after { border: none; }
.photo-delete { width: 100%; }
.photo-add { margin: 0 0 0 auto; }
.photos-section { margin: 28rpx 0; }
.photos-section .section-head { margin-bottom: 0; gap: 16rpx; align-items: center; }
.source-trace { padding: 12px 0; border-top: 1px solid var(--line); white-space: pre-wrap; font-size: 16px; line-height: 1.8; }
.source-trace view + view { margin-top: 24rpx; }
.draft-hint { margin-top: 12rpx; font-size: max(24rpx, 13px); line-height: 1.6; color: var(--ink-3); }
.origin-editor, .tl-editor { box-sizing: border-box; padding: 20rpx; border: 1px solid var(--field-line); border-radius: 16rpx; background: var(--surface); }

.todo-inline { display: flex; flex-wrap: wrap; align-items: center; gap: 4rpx 20rpx; margin-top: 8rpx; }
.todo-inline .todo-check, .todo-inline .todo-date, .todo-inline .todo-more { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; box-sizing: border-box; min-height: max(88rpx, 44px); line-height: 1.4; font-weight: 400; }
.todo-inline .todo-date { white-space: nowrap; word-break: keep-all; }
.origin-todo { margin: 0 0 16rpx; }
.todo-check { display: inline-flex; align-items: center; gap: 14rpx; margin: 0; padding: 0; background: transparent; border: none; border-radius: 0; color: var(--brand); font-size: max(26rpx, 14px); line-height: 1.4; }
.todo-check::after { border: none; }
.todo-check[disabled] { color: var(--ink-3); background: transparent; }
.todo-box { box-sizing: border-box; display: inline-flex; align-items: center; justify-content: center; width: 36rpx; height: 36rpx; min-width: 18px; min-height: 18px; border: 1px solid currentColor; border-radius: 6rpx; font-size: 13px; line-height: 1; }
.todo-check.is-done { color: var(--ink-2); }
.todo-check.is-done .todo-box { color: #fff; border-color: var(--brand); background: var(--brand); }
.todo-date { font-size: max(24rpx, 13px); color: var(--ink-2); }
.todo-more { margin-left: auto; }
.todo-date-sheet .sheet-title { color: var(--ink); font-size: max(32rpx, 16px); font-weight: 500; border-bottom: 0; }
.todo-date-sheet .btn-block { width: calc(100% - 56rpx); margin: 0 28rpx; }
.todo-date-panel { padding: 0 28rpx 28rpx; }
.todo-source-quote { margin-bottom: 24rpx; padding: 20rpx; border-radius: 12rpx; background: var(--paper); color: var(--ink-2); font-size: max(26rpx, 13px); font-weight: 400; line-height: 1.6; white-space: pre-wrap; word-break: break-all; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.todo-undo { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; padding: 0 20rpx; background: var(--brand-soft); border-radius: 12rpx; font-size: max(26rpx, 14px); }
.todo-highlight { background: var(--brand-soft); outline: 2px solid var(--brand-line); outline-offset: 8rpx; border-radius: 8rpx; opacity: 1; }

@media (max-width: 350px) {
  .origin-text, .origin-editor { font-size: 16px; }
  .tl-what { font-size: 15px; }
}

.detail-page { padding-bottom: calc(110px + env(safe-area-inset-bottom)); }
.detail-page .detail-head { margin-top: 5px; margin-bottom: 12px; min-height: 20px; }
.detail-page .origin-text { font-size: 17px; line-height: 1.95; }
.detail-page .detail-actions { margin: 0; padding-bottom: calc(15px + env(safe-area-inset-bottom)); }
.detail-page .detail-actions .btn { min-height: 48px; margin: 0; }
.detail-page .detail-actions .a-supplement-action { flex: 1; }
.detail-page .detail-actions .btn-quiet { flex: 0 0 auto; }
.detail-page .compose-foot .btn { display: none; }
.detail-page .detail-next[hidden] { display: none; }
.detail-page .compose-editor { height: 160px; min-height: 160px; padding: 6px 0; border: 0; border-bottom: 1px solid var(--line); border-radius: 0; font-size: 16px; line-height: 1.8; }
.detail-page .detail-next { padding: 18px 0; }
.detail-page .detail-next .todo-setting-hint { display: none; }
.detail-page .detail-next .todo-setting-toggle { min-height: 56px; }
