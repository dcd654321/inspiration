/* 顶部：时间与低频操作的入口。低频操作全部收进「更多」，正文上方保持安静 */
.detail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.detail-head .stamp {
  font-size: 24rpx;
  font-size: max(24rpx, 13px);
  color: var(--ink-3);
  padding-bottom: 0;
}

.detail-more {
  flex: 0 0 auto;
  min-width: 88rpx;
  min-height: 88rpx;
  margin: -16rpx -16rpx -16rpx 0;
  padding: 0 20rpx;
  border: none;
  background: transparent;
  color: var(--brand);
  font-size: 27rpx;
  font-size: max(27rpx, 14px);
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.detail-more::after { border: none; }

.detail-more[disabled] { opacity: 0.55; }

/* 轻量动作：两个主任务的入口，等宽一行 */
.detail-actions {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0 8rpx;
}

.compose .field-label { margin-bottom: 12rpx; }

.detail-actions .btn {
  flex: 1 1 0;
  min-width: 0;
  margin: 0;
  padding: 0 12rpx;
  box-sizing: border-box;
}

/* ---------------------------------------------------------------- 原文：锚点 */

.origin {
  padding-bottom: 8rpx;
}

/* 原文用系统衬线。它是「用户自己写下的那句话」，字号已经最大，再用字族和界面其余部分
   拉开一层——补充、按钮、说明都留在无衬线里，层级因此不靠加粗或颜色。

   平台差异要知道：Android 多数机型没有中文衬线字体，会回落到无衬线。这是降级，不是损坏，
   但两端观感不同，真机上要分别看过再决定留不留。编辑器用同一字族，进入编辑时不会突然跳字体。 */
.origin-text,
.origin-editor {
  width: 100%;
  font-size: 38rpx;
  font-size: max(38rpx, 19px);
  line-height: 1.78;
  letter-spacing: 0.012em;
  color: var(--ink);
  font-family: "Songti SC", "STSong", "SimSun", Georgia, serif;
}

.origin-acts {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 36rpx;
}

/* ---------------------------------------------------------------- 补充时间线 */

.hint-line {
  font-size: 28rpx;
  font-size: max(28rpx, 14px);
  color: var(--ink-3);
  padding: 20rpx 0;
}

.timeline {
  position: relative;
}

.tl-item {
  position: relative;
  padding: 28rpx 0 28rpx 40rpx;
}

/* 圆点。用 box-shadow 在外圈垫一圈底色，让竖线看起来是从圆点后面穿过的 */
.tl-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 42rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #cdcdd8;
  box-shadow: 0 0 0 6rpx var(--paper);
  z-index: 1;
}

.tl-ai::before {
  background: var(--brand);
}

/* 竖线。最后一条不画，避免尾巴拖出半截 */
.tl-item:not(:last-child)::after {
  content: "";
  position: absolute;
  left: 6rpx;
  top: 52rpx;
  bottom: -4rpx;
  width: 2rpx;
  background: var(--line);
}

.tl-when {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  font-size: 25rpx;
  font-size: max(25rpx, 13px);
  color: var(--ink-3);
  margin-bottom: 10rpx;
}

/* 一行三个等宽。之前固定两列，按钮数为奇数时最后一个独占半行、左对齐，看着像漏了一个。 */
.output-acts {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0 0;
}

.output-acts .btn {
  flex: 1 1 0;
  min-width: 0;
  margin: 0;
  padding: 0 12rpx;
  box-sizing: border-box;
}


.origin-acts .btn, .tl-acts .btn, .compose-foot .btn {
  width: auto;
  margin: 0;
}

.detail-next { margin-bottom: 40rpx; }

.detail-next .section-head {
  margin-bottom: 12rpx;
}

.tl-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  min-width: 0;
}

.tl-more {
  flex: 0 0 auto;
  min-width: 88rpx;
  min-height: 88rpx;
  margin: -20rpx -20rpx -20rpx 0;
  padding: 0 20rpx;
  border: none;
  background: transparent;
  color: var(--brand);
  font-size: 25rpx;
  font-size: max(25rpx, 14px);
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.tl-more::after { border: none; }

.tl-what {
  font-size: 29rpx;
  font-size: max(29rpx, 16px);
  line-height: 1.72;
  letter-spacing: 0.01em;
}

/* ---------------------------------------------------------------- 追加补充 */

.compose {
  background: var(--surface);
  border-radius: 20rpx;
  padding: 24rpx 26rpx 22rpx;
  border: 1px solid var(--field-line);
}

/* 补充输入器固定两档：空且未聚焦 64px，聚焦或已有内容 160px。
   **关闭 auto-height**——固定高度与自动增高同时存在会互相打架。
   多余文字在输入框内部滚动；px 兜底避免 320 宽时缩得过小。 */
.compose-editor {
  width: 100%;
  height: 128rpx;
  height: max(128rpx, 64px);
  font-size: 28rpx;
  font-size: max(28rpx, 16px);
  line-height: 1.7;
  color: var(--ink);
}

.compose-editor.compose-tall {
  height: 320rpx;
  height: max(320rpx, 160px);
}

.count-over {
  color: var(--danger);
}

.hint-over {
  font-size: 24rpx;
  font-size: max(24rpx, 13px);
  color: var(--danger);
  margin-top: 12rpx;
}

.compose-ph {
  color: var(--ink-3);
}

.compose-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.count {
  font-size: 24rpx;
  font-size: max(24rpx, 13px);
  color: var(--ink-3);
}

/* ---------------------------------------------------------------- 补充的行内修改 */

.tl-editor {
  width: 100%;
  min-height: 80rpx;
  font-size: 29rpx;
  font-size: max(29rpx, 16px);
  line-height: 1.72;
  color: var(--ink);
}

.tl-acts {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* ---------------------------------------------------------------- 已收起的补充 */

.hidden-block {
  margin-top: 12rpx;
}

.hidden-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 14rpx 0;
  font-size: 26rpx;
  font-size: max(26rpx, 13px);
  line-height: 1.5;
  color: var(--ink-2);
  background: transparent;
  border-radius: 0;
  border-bottom: 2rpx dashed var(--line-strong);
}

.hidden-row::after { border: none; }

.tl-hidden {
  opacity: 0.72;
}

.tl-hint {
  font-size: 25rpx;
  font-size: max(25rpx, 13px);
  color: var(--ink-3);
  margin-top: 8rpx;
}

/* ---------------------------------------------------------------- 整理标记 */

.organization { margin: 28rpx 0; padding: 24rpx; border: 1rpx solid var(--line); border-radius: 20rpx; }
/* 收起行：左边是当前状态摘要，右边是动作词。表单只在真要改时摊开 */
.org-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 88rpx;
}
.org-value { flex: 1; min-width: 0; font-size: max(28rpx, 14px); line-height: 1.5; color: var(--ink-2); }
.org-toggle { flex: 0 0 auto; font-size: max(27rpx, 14px); color: var(--brand); }
/* 可编辑字段必须有看得见的输入边界。
   标签输入框原来是裸 input，在卡片里和一行说明文字长得一模一样，没人知道它能改。 */
.organization input,
.organization .stage-picker {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  font-size: max(28rpx, 16px);
  line-height: 88rpx;
  color: var(--ink);
  background: var(--paper);
  border: 1px solid var(--field-line);
  border-radius: 16rpx;
}
.organization .stage-picker { display: flex; align-items: center; }
/* 标记表单的动作行：保存标记 / 取消，取消恢复进入前的值 */
.org-acts { display: flex; gap: 16rpx; margin-top: 24rpx; }
.org-acts .btn { width: auto; margin: 0; }

/* 长正文的定位入口：滚离原文后出现，落在右下角，不遮挡时间线的阅读；
   不用投影——层级仍靠实心底色区分 */
.float-supplement {
  position: fixed;
  right: 40rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  min-height: 88rpx;
  padding: 0 36rpx;
  border: none;
  border-radius: 44rpx;
  background: var(--brand);
  color: #ffffff;
  font-size: 28rpx;
  font-size: max(28rpx, 14px);
  line-height: 1;
  display: inline-flex;
  align-items: center;
  z-index: 50;
}

.float-supplement::after { border: none; }
.source-link { text-align: left; white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.7; padding: 20rpx 0; }
.photo-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 20rpx 0; }
.photo-cell { width: 30%; }
.photo-cell image { width: 100%; height: 190rpx; border-radius: 16rpx; background: #eceae4; }
.photos-section { margin: 36rpx 0; }
.source-trace { padding: 20rpx; border-left: 3rpx solid var(--line-strong); white-space: pre-wrap; font-size: max(27rpx, 16px); line-height: 1.8; }
.source-trace view + view { margin-top: 24rpx; }
.draft-hint { margin-top: 12rpx; font-size: max(24rpx, 13px); line-height: 1.6; color: var(--ink-3); }
.origin-editor, .tl-editor { box-sizing: border-box; padding: 20rpx; border: 1px solid var(--field-line); border-radius: 16rpx; background: var(--surface); }
