<view class="page" wx:if="{{ready}}">
  <!-- 读取失败与「确认不存在」分开：网络问题不能说成灵感已被删除 -->
  <block wx:if="{{readError}}">
    <view class="empty">
      <view class="et">暂时无法读取灵感</view>
      <view class="ed">{{error || '请稍后重试。'}}</view>
    </view>
    <button class="btn btn-plain btn-block" style="margin-top: 32rpx" bindtap="onRetryLoad">重新读取</button>
    <button class="btn btn-quiet btn-block" style="margin-top: 20rpx" bindtap="onBackToList">返回灵感列表</button>
  </block>

  <block wx:elif="{{missing}}">
    <view class="empty">
      <view class="et">找不到这条灵感</view>
      <view class="ed">它可能已被删除，可以返回列表查找其他记录。</view>
    </view>
    <button class="btn btn-block" style="margin-top: 32rpx" bindtap="onBackToList">返回灵感列表</button>
  </block>

  <block wx:else>
    <view class="page-title">整理成稿</view>
    <!-- 进入即有可编辑稿件；材料与格式按需调整 -->
    <view class="output-summary">{{summary}}</view>
    <view wx:if="{{draftRecoveryNotice}}" class="recovery-note" aria-live="polite">{{draftRecoveryNotice}}</view>
    <view class="output-tools">
      <button class="btn-link" bindtap="onOpenContent" disabled="{{busy || saveUnknown}}">调整内容</button>
      <button class="btn-link" bindtap="onOpenFormat" disabled="{{busy || saveUnknown}}">选择格式</button>
      <button class="btn-link" bindtap="onOpenMore" disabled="{{busy}}">更多</button>
    </view>

    <view class="field-label draft-label">这份稿件</view>
    <textarea class="draft-editor {{saveUnknown ? 'draft-pending' : ''}}" value="{{draft}}" maxlength="-1" bindinput="onDraftInput" disabled="{{busy || saveUnknown}}" cursor-spacing="24" aria-label="编辑稿件" />
    <view class="draft-count {{draft.length > maxLength ? 'count-over' : ''}}">
      <text wx:if="{{draft.length > maxLength}}">另存最多{{maxLength}}字符，当前超出{{draft.length - maxLength}}字符。</text>
      <text wx:else>{{draft.length}}字符 · 另存最多{{maxLength}}字符</text>
    </view>

    <view class="selection-note">可以直接编辑，原记录不会改变。</view>
    <view wx:if="{{!savedSame}}" class="selection-note draft-leave-hint">稿件仅在本次使用中保留，关闭小程序前请复制或另存。</view>
    <view wx:if="{{sourceStale}}" class="notice notice-warn"><view class="mark"></view><view class="notice-body"><view>素材已变化，当前稿件仍可复制。请重新选择素材后再保存。</view><button class="btn-link" bindtap="onOpenContent" disabled="{{busy}}">重新选择内容</button></view></view>
    <view wx:if="{{error}}" class="notice {{saveUnknown ? 'notice-warn' : 'notice-err'}}"><view class="mark"></view><text>{{error}}</text></view>
    <button class="btn btn-block main-action" bindtap="onCopyDraft" disabled="{{busy || !draft.length}}">复制稿件</button>
    <button class="btn btn-quiet btn-block secondary-action" bindtap="onSaveAsNew" disabled="{{busy || sourceStale || !canSaveAs}}">{{busy ? '正在另存…' : saveUnknown ? '重试确认保存' : (savedSame ? '已另存' : '另存为新灵感')}}</button>
    <button class="btn btn-plain btn-block secondary-action" bindtap="onShareDraft" disabled="{{busy || saveUnknown || sourceStale || !draft.length}}">{{savedSame ? '分享这份稿件' : '保存并预览分享'}}</button>
    <view wx:if="{{noticeLink}}" class="saved-link"><button class="btn btn-link" bindtap="onOpenSaved">查看新灵感</button></view>

    <view wx:if="{{notice}}" class="notice notice-success"><view class="mark"></view><text>{{notice}}</text></view>
  </block>

  <!-- 调整内容：正文固定带入，补充可选；取消不改动稿件 -->
  <view wx:if="{{phase === 'content'}}" class="mask" bindtap="onClosePanel">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">调整内容</view>
      <view class="sheet-hint">正文始终保留；已并入正文或已合并的补充不会重复加入。</view>
      <scroll-view scroll-y="true" class="sheet-scroll" style="{{sheetScrollHeight ? 'height: ' + sheetScrollHeight + 'px;' : ''}}">
        <view wx:if="{{stagedOptions.length === 0}}" class="sheet-hint">还没有可选择的补充，稿件只包含正文。</view>
        <button wx:for="{{stagedOptions}}" wx:key="id" class="sheet-item option-item" data-id="{{item.id}}" bindtap="onToggleSupplement" aria-label="{{item.selected ? '取消选择' : '选择'}}补充">
          <text class="option-check {{item.selected ? 'option-checked' : ''}}">{{item.selected ? '✓' : ''}}</text>
          <text class="option-text">{{item.content}}</text>
        </button>
      </scroll-view>
      <view class="panel-acts">
        <button class="btn btn-plain btn-sm" bindtap="onClosePanel">取消</button>
        <button class="btn btn-sm" bindtap="onApply" disabled="{{busy}}">应用选择</button>
      </view>
    </view>
  </view>

  <!-- 选择格式：不新增模板；替换受保护 -->
  <view wx:if="{{phase === 'format'}}" class="mask" bindtap="onClosePanel">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">选择格式</view>
      <view class="format-options">
        <button wx:for="{{templates}}" wx:key="id" class="template-option {{stagedTemplateId === item.id ? 'template-selected' : ''}}" data-template="{{item.id}}" bindtap="onTemplateSelect">{{item.name}}</button>
      </view>
      <view class="sheet-hint">只整理已有文字，不自动补写。留空的部分可以自己补写。</view>
      <view class="panel-acts">
        <button class="btn btn-plain btn-sm" bindtap="onClosePanel">取消</button>
        <button class="btn btn-sm" bindtap="onApply" disabled="{{busy}}">应用格式</button>
      </view>
    </view>
  </view>

  <!-- 更多：文字留档等低频能力收在这里 -->
  <view wx:if="{{phase === 'more'}}" class="mask" bindtap="onClosePanel">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">更多</view>
      <button class="sheet-item" bindtap="onOpenArchive">文字留档<text class="sub">包含正文、补充和修改记录，不含照片</text></button>
      <button class="sheet-cancel" bindtap="onClosePanel">取消</button>
    </view>
  </view>

  <!-- 文字留档：整条记录的带时间副本，可复制或生成 TXT -->
  <view wx:if="{{phase === 'archive'}}" class="mask" bindtap="onClosePanel">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">文字留档</view>
      <view class="sheet-hint">包含正文、补充和修改记录，不含照片。删除原记录后，已复制或导出的文字仍会保留。</view>
      <scroll-view scroll-y="true" class="sheet-scroll" style="{{sheetScrollHeight ? 'height: ' + sheetScrollHeight + 'px;' : ''}}">
        <view class="archive-preview"><text selectable="true">{{archive}}</text></view>
      </scroll-view>
      <view class="archive-acts">
        <button class="btn btn-block main-action" bindtap="onCopyArchive" disabled="{{busy}}">复制留档文字</button>
        <button class="btn btn-quiet btn-block secondary-action" bindtap="onCreateTxt" disabled="{{busy}}">{{busy ? '正在处理…' : '生成 TXT 文件'}}</button>
        <button wx:if="{{txtPath}}" class="btn btn-quiet btn-block secondary-action" bindtap="onShareTxt" disabled="{{busy}}">发送 TXT 文件</button>
      </view>
      <view wx:if="{{error}}" class="notice notice-err"><view class="mark"></view><text>{{error}}</text></view>
      <view wx:if="{{notice}}" class="notice notice-success"><view class="mark"></view><text>{{notice}}</text></view>
      <button class="sheet-cancel" bindtap="onClosePanel" disabled="{{busy}}">返回稿件</button>
    </view>
  </view>
</view>
