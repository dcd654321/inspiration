/* 整理成稿：进入即有可编辑稿件，工具行与结果区都保持安静 */

.output-summary {
  margin-top: 14rpx;
  font-size: 27rpx;
  color: var(--ink-2);
}

.output-tools {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 20rpx 0 4rpx;
}

.output-tools .btn-link {
  width: auto;
  margin: 0;
  padding: 0 14rpx;
  display: inline-flex;
  align-items: center;
}

.selection-note {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.65;
  color: var(--ink-3);
}

.main-action { margin-top: 28rpx; }
.secondary-action { margin-top: 16rpx; }

.draft-editor {
  width: 100%;
  height: 520rpx;
  height: max(520rpx, 260px);
  margin-top: 24rpx;
  padding: 30rpx;
  box-sizing: border-box;
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 18rpx;
  color: var(--ink);
  font-size: 29rpx;
  line-height: 1.7;
}
.draft-count { margin-top: 10rpx; color: var(--ink-3); font-size: 24rpx; text-align: right; }
.count-over { color: var(--danger); }
.saved-link { margin-top: 16rpx; }
.saved-link .btn-link { width: auto; margin: 0; }

/* 面板里的说明与滚动区 */
.sheet-hint {
  padding: 20rpx 40rpx 0;
  font-size: 25rpx;
  line-height: 1.65;
  color: var(--ink-3);
}

.sheet-scroll {
  max-height: 56vh;
  margin-top: 16rpx;
}

/* 内容选择项：与补充操作面板同一样式，左侧多一个勾选框 */
.sheet .option-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.option-check {
  flex: 0 0 34rpx;
  height: 34rpx;
  margin-top: 6rpx;
  border: 2rpx solid var(--line-strong);
  border-radius: 8rpx;
  color: #fff;
  font-size: 26rpx;
  line-height: 34rpx;
  text-align: center;
}

.option-checked { background: var(--brand); border-color: var(--brand); }

.option-text {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 格式选择 */
.format-options { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 24rpx 40rpx 0; }
.format-options .template-option { width: auto; flex: 0 0 auto; margin: 0; padding: 0 22rpx; min-height: 88rpx; line-height: 88rpx; font-size: 26rpx; background: var(--surface); color: var(--ink-2); border: 1rpx solid var(--line); border-radius: 18rpx; }
.template-option::after { border: 0; }
.format-options .template-selected { background: var(--brand-soft); color: var(--brand); border-color: var(--brand); }

/* 留档 */
.archive-preview {
  padding: 30rpx;
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 18rpx;
  color: var(--ink-2);
  font-size: 25rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}

.archive-acts { padding: 0 40rpx; }
.archive-acts .btn-block { margin-top: 16rpx; }
.archive-acts .main-action { margin-top: 24rpx; }
