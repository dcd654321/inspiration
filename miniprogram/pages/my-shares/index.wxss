.myshares-state { margin: 56rpx 0; font-size: max(27rpx, 14px); line-height: 1.7; color: var(--ink-2); }
.myshares-card { margin-top: 24rpx; padding: 28rpx; background: var(--surface); border-radius: 20rpx; }
.myshares-top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12rpx; color: var(--ink-3); font-size: max(24rpx, 13px); }
.myshares-status { color: var(--brand); font-weight: 600; }
.myshares-title { margin-top: 18rpx; font-size: max(31rpx, 16px); font-weight: 600; word-break: break-all; }
.myshares-preview { margin-top: 10rpx; color: var(--ink-2); font-size: max(26rpx, 16px); line-height: 1.7; word-break: break-all; }
.myshares-date { margin-top: 16rpx; color: var(--ink-3); font-size: max(23rpx, 13px); }
.myshares-actions { display: flex; gap: 12rpx; margin-top: 22rpx; }
.myshares-actions .btn { flex: 1; padding: 0 14rpx; }
