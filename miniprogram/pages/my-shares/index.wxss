.myshares-state { margin: 56rpx 0; font-size: 27rpx; line-height: 1.7; color: var(--ink-2); }
.myshares-card { margin-top: 24rpx; padding: 28rpx; background: var(--surface); border-radius: 20rpx; }
.myshares-top { display: flex; justify-content: space-between; gap: 12rpx; color: var(--ink-3); font-size: 24rpx; }
.myshares-status { color: var(--brand); font-weight: 600; }
.myshares-title { margin-top: 18rpx; font-size: 31rpx; font-weight: 600; }
.myshares-preview { margin-top: 10rpx; color: var(--ink-2); font-size: 26rpx; line-height: 1.6; overflow-wrap: anywhere; }
.myshares-date { margin-top: 16rpx; color: var(--ink-3); font-size: 23rpx; }
.myshares-actions { display: flex; gap: 12rpx; margin-top: 22rpx; }
.myshares-actions .btn { flex: 1; padding: 0 14rpx; }
