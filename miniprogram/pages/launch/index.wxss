/* 启动过渡页与工作页共用白底、字阶和主操作。 */
.launch { min-height: 100vh; box-sizing: border-box; display: flex; flex-direction: column; padding: calc(env(safe-area-inset-top) + 80px) 22px calc(44px + env(safe-area-inset-bottom)); background: var(--surface); }
.launch-center { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding-bottom: 40px; animation: launch-rise 360ms cubic-bezier(0.16, 1, 0.3, 1); }
.launch-mark { width: 64px; height: 64px; border-radius: 16px; }
.launch-name { margin-top: 20px; color: var(--ink); font-size: max(54rpx, 27px); font-weight: 600; letter-spacing: -0.02em; line-height: 1.4; }
.launch-line { margin-top: 9px; color: var(--ink-2); font-size: max(28rpx, 14px); line-height: 1.8; }
.launch-foot { display: flex; flex-direction: column; align-items: center; width: 100%; }
.launch-track { position: relative; width: 160px; height: 2px; border-radius: 2px; background: var(--line); overflow: hidden; }
.launch-spark { position: absolute; top: 0; left: 0; width: 36px; height: 2px; border-radius: 2px; background: var(--brand); animation: launch-travel 1.8s ease-in-out infinite; }
.launch-status { margin-top: 13px; color: var(--ink-2); font-size: max(26rpx, 13px); line-height: 1.8; }
.launch-error { max-width: 560rpx; margin-top: 0; color: var(--danger); text-align: center; word-break: break-all; }
.launch .launch-action { width: 100%; margin-top: 18px; }
@keyframes launch-rise { from { opacity: 0.7; transform: translateY(8px); } to { opacity: 1; transform: none; } }
@keyframes launch-travel { 0% { transform: translateX(-36px); } 100% { transform: translateX(160px); } }
@media (max-width: 350px) { .launch { padding-right: 17px; padding-left: 17px; } .launch-name { font-size: 26px; } }
@media (prefers-reduced-motion: reduce) { .launch-center { animation: none; } .launch-spark { animation: none; left: 62px; } }
