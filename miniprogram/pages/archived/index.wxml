<view class="page">
  <view class="page-title">已归档</view>
  <view class="page-sub">取消归档后，可继续补充和整理。</view>
  <view wx:if="{{count > 0}}" class="search-box">
    <input value="{{query}}" bindinput="onSearch" maxlength="100" placeholder="搜索归档的正文、补充或标签" aria-label="搜索归档的正文、补充或标签" confirm-type="search" />
    <button wx:if="{{query}}" class="btn-link" bindtap="onClearQuery">清空搜索</button>
  </view>
  <view wx:if="{{items.length && (loading || error)}}" class="refresh-status" aria-live="polite">
    <text>{{loading ? '正在更新…' : error}}</text>
    <button wx:if="{{!loading}}" class="btn-link" bindtap="onRetry">重试</button>
  </view>
  <view wx:if="{{loading && items.length === 0}}" class="skeleton-list">
    <view class="skeleton-row" wx:for="{{[1, 2, 3]}}" wx:key="*this"><view class="skeleton-line"></view><view class="skeleton-line"></view></view>
  </view>
  <block wx:elif="{{error && items.length === 0}}">
    <view class="empty"><view class="et">暂时无法读取归档</view><view class="ed">{{error}}</view></view>
    <button class="btn btn-plain btn-block" bindtap="onRetry">重新读取</button>
  </block>
  <block wx:elif="{{items.length === 0 && query}}">
    <view class="empty"><view class="et">没有找到匹配的归档灵感</view><view class="ed">试试其他关键词。</view></view>
    <button class="btn btn-quiet btn-block" bindtap="onClearQuery">清空搜索</button>
  </block>
  <view wx:elif="{{items.length === 0}}" class="empty">
    <view class="et">还没有归档的灵感</view><view class="ed">可在灵感详情的「更多」中归档。</view>
  </view>
  <block wx:else>
    <view class="list-head"><view class="list-head-title"><text class="k">最近归档</text><text class="v">共 {{items.length}} 条</text></view></view>
    <view class="list">
      <view wx:for="{{items}}" wx:key="id" class="row" hover-class="row-active" data-id="{{item.id}}" bindtap="onOpen">
        <view class="row-main">
          <view class="body">{{item.excerpt}}</view>
          <view class="item-tags"><text>{{item.stage}}</text><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text></view>
          <view wx:if="{{item.matchText}}" class="match-snippet"><text class="match-source">{{item.matchSource}} · </text><text>{{item.matchText}}</text></view>
          <view class="meta"><text>归档于 {{item.time}}</text><block wx:if="{{item.supplements}}"><view class="sep"></view><text>{{item.supplements}}</text></block><block wx:if="{{item.photos}}"><view class="sep"></view><text>{{item.photos}} 张照片</text></block></view>
        </view>
      </view>
    </view>
  </block>
</view>
