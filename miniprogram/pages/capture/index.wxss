.capture-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.capture-mark {
  flex: 0 0 auto;
  width: 104rpx;
  height: 104rpx;
  border-radius: 26rpx;
}

.composer {
  background: var(--surface);
  border-radius: 24rpx;
  padding: 32rpx 32rpx 28rpx;
  margin-top: 36rpx;
}

.editor {
  width: 100%;
  min-height: 216rpx;
  font-size: 33rpx;
  line-height: 1.75;
  letter-spacing: 0.01em;
  color: var(--ink);
}

.editor-ph {
  color: var(--ink-3);
}

.foot {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 28rpx;
}

.count {
  font-size: 24rpx;
  color: var(--ink-3);
}

.count-near {
  color: var(--warn-ink);
}

.save-btn {
  margin-top: 24rpx;
}

.save-result {
  flex: 1;
  min-width: 0;
}

.result-link {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  margin: 6rpx 0 -18rpx;
  padding: 0;
  color: var(--brand);
  background: transparent;
  font-size: 27rpx;
  font-weight: 600;
  text-align: left;
}

.result-link::after {
  border: none;
}
