.composer {
  background: var(--surface);
  border-radius: 24rpx;
  padding: 32rpx 32rpx 28rpx;
  margin-top: 36rpx;
}

.editor {
  width: 100%;
  min-height: 216rpx;
  font-size: 33rpx;
  line-height: 1.75;
  letter-spacing: 0.01em;
  color: var(--ink);
}

.editor-ph {
  color: var(--ink-3);
}

.foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
}

.count {
  font-size: 24rpx;
  color: var(--ink-3);
}

.count-near {
  color: var(--danger);
}
