.capture-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.capture-mark {
  flex: 0 0 auto;
  width: 104rpx;
  height: 104rpx;
  border-radius: 26rpx;
}

.composer {
  background: var(--surface);
  border-radius: 24rpx;
  padding: 32rpx 32rpx 28rpx;
  margin-top: 36rpx;
}

.editor {
  width: 100%;
  min-height: 300rpx;
  font-size: 33rpx;
  line-height: 1.75;
  letter-spacing: 0.01em;
  color: var(--ink);
}

.editor-ph {
  color: var(--ink-3);
}

.foot {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 28rpx;
}

.foot-hints {
  flex: 1;
  min-width: 0;
}

.hint-draft {
  font-size: 24rpx;
  color: var(--ink-3);
}

/* 超限时说清差多少，并保持全文可见——不静默截断粘贴内容 */
.hint-over {
  font-size: 24rpx;
  color: var(--danger);
}

.count {
  flex: 0 0 auto;
  font-size: 24rpx;
  color: var(--ink-3);
}

.count-near {
  color: var(--warn-ink);
}

.count-over {
  color: var(--danger);
}

.save-btn {
  margin-top: 24rpx;
}

/* 成功卡里的摘录：就是刚确认写入的那条文字，两行封顶 */
.saved-quote {
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--ink-2);
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  white-space: pre-wrap;
  word-break: break-all;
}

.hint-copy {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 16rpx;
}
