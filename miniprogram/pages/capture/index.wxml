<view class="page">
  <view class="page-title">记下这一句</view>
  <view class="page-sub">半句话也可以。</view>

  <view class="composer">
    <textarea
      class="editor"
      value="{{draft}}"
      maxlength="{{maxLength}}"
      placeholder="此刻想到什么？"
      placeholder-class="editor-ph"
      bindinput="onInput"
      disabled="{{saving}}"
      auto-height
    />

    <view class="foot">
      <text class="count {{nearLimit ? 'count-near' : ''}}">{{draft.length}} / {{maxLength}}</text>
      <button
        class="btn"
        bindtap="onSave"
        disabled="{{draft.length === 0 || saving}}"
      >{{saving ? '保存中…' : '保存'}}</button>
    </view>

    <!-- 失败提示常驻页面，不用会自动消失的 toast：用户错过之后会以为已经保存 -->
    <view wx:if="{{error}}" class="notice notice-err">
      <view class="mark"></view>
      <text>{{error}}</text>
    </view>
  </view>
</view>
