<view class="page capture-page a-screen">
  <view class="a-brandline"><image src="/assets/brand-mark.png" mode="aspectFit" />灵感拾光簿</view>
  <view class="capture-head a-heading">
    <view class="page-title capture-title">记录</view>
  </view>
  <view class="capture-intro">{{todayDate}}</view>
  <view wx:if="{{draftRecoveryNotice}}" class="recovery-note" aria-live="polite">{{draftRecoveryNotice}}</view>

  <view class="composer">
    <view class="field-label">灵感正文</view>
    <textarea
      class="editor"
      value="{{draft}}"
      maxlength="-1"
      placeholder="{{lastSavedId ? '继续写下一个想法…' : '此刻想到什么？'}}"
      placeholder-class="editor-ph"
      bindinput="onInput"
      bindfocus="onFocus"
      bindblur="onBlur"
      aria-label="此刻的想法"
      cursor-spacing="24"
      disabled="{{saving || photoBusy}}"
      focus="{{inputFocus}}"
    />

    <view class="foot">
      <button class="btn-link capture-photo-add" bindtap="onAddPhoto" disabled="{{saving || photoBusy}}" hover-class="a-control-pressed"><view class="capture-camera-icon" aria-hidden="true"></view>{{photoBusy ? '正在添加…' : '添加照片'}}</button>
      <view class="foot-hints">
        <text wx:if="{{overBy > 0}}" class="hint-over">超出{{overBy}}字符，请缩短后保存。</text>
        <text wx:elif="{{saving}}" class="hint-draft">正在保存，请稍候。</text>
        <text wx:elif="{{draft && status === ''}}" class="hint-draft">尚未保存，退出后可能丢失。</text>
      </view>
      <text class="count {{nearLimit ? 'count-near' : ''}} {{overBy > 0 ? 'count-over' : ''}}">{{draft.length}} / {{maxLength}}</text>
    </view>

    <view wx:if="{{photos.length}}" class="capture-photos">
      <scroll-view class="capture-photo-strip" scroll-x>
        <view wx:for="{{photos}}" wx:key="id" class="capture-photo-cell" data-id="{{item.id}}" bindtap="onPreviewCapturePhoto" role="button" aria-label="查看照片">
          <image wx:if="{{item.src}}" class="capture-photo-preview" src="{{item.src}}" mode="aspectFill" data-id="{{item.id}}" data-src="{{item.src}}" binderror="onCapturePhotoError" show-menu-by-longpress="{{false}}" />
          <button wx:elif="{{item.failed}}" class="capture-photo-preview capture-photo-retry" bindtap="loadCapturePhotos">照片未加载<text>点击重试</text></button>
          <view wx:else class="capture-photo-preview capture-photo-loading">照片加载中…</view>
        </view>
      </scroll-view>
    </view>
    <view wx:if="{{photoError}}" class="capture-photo-error" aria-live="polite">{{photoError}}</view>
    <view wx:if="{{!lastSavedId && !photoBusy}}" class="capture-photo-hint">添加照片会先保存当前记录。</view>

    <view class="todo-setting {{todoEnabled ? 'is-active' : ''}}">
      <button class="todo-setting-toggle" bindtap="onToggleTodo" aria-pressed="{{todoEnabled}}" disabled="{{saving || photoBusy || status === 'unknown'}}">
        <view class="todo-entry-icon" aria-hidden="true"><view class="todo-entry-line"></view><view class="todo-entry-line"></view></view>
        <view class="todo-setting-copy"><text class="todo-setting-title">加入待办</text><text class="todo-setting-hint">{{todoEnabled ? '保存后会出现在「待办」页' : '把这条内容作为接下来要做的事'}}</text></view>
        <view class="todo-setting-switch" aria-hidden="true"><view class="todo-setting-knob"></view></view>
      </button>
      <view wx:if="{{todoEnabled}}" class="todo-setting-dates">
        <view class="todo-date-label">计划完成日 · 可选</view>
        <view class="todo-date-actions">
          <button class="todo-date-chip {{!todoDueDate ? 'chosen' : ''}}" aria-pressed="{{!todoDueDate}}" data-kind="none" bindtap="onTodoDate" disabled="{{saving || photoBusy || status === 'unknown'}}">不设日期</button>
          <button class="todo-date-chip {{todoDueDate === todayDate ? 'chosen' : ''}}" aria-pressed="{{todoDueDate === todayDate}}" data-kind="today" bindtap="onTodoDate" disabled="{{saving || photoBusy || status === 'unknown'}}">今天</button>
          <button class="todo-date-chip {{todoDueDate === tomorrowDate ? 'chosen' : ''}}" aria-pressed="{{todoDueDate === tomorrowDate}}" data-kind="tomorrow" bindtap="onTodoDate" disabled="{{saving || photoBusy || status === 'unknown'}}">明天</button>
          <picker class="todo-date-picker" mode="date" value="{{todoDueDate || todayDate}}" bindchange="onTodoDateChange" disabled="{{saving || photoBusy || status === 'unknown'}}" aria-label="选择计划完成日"><view class="todo-date-chip {{todoDueDate && todoDueDate !== todayDate && todoDueDate !== tomorrowDate ? 'chosen' : ''}}">{{todoDueDate && todoDueDate !== todayDate && todoDueDate !== tomorrowDate ? todoDueDate : '选择日期'}}</view></picker>
        </view>
      </view>
    </view>

    <view class="capture-tags-row">
      <view class="capture-tags-label"><view class="capture-tag-icon" aria-hidden="true"></view><text>标签</text></view>
      <input class="capture-tags-input" value="{{tagsDraft}}" bindinput="onTagsInput" placeholder="选填，用空格分开" placeholder-class="search-ph" maxlength="-1" disabled="{{saving || photoBusy}}" aria-label="灵感标签，用空格或逗号分开，最多五个" />
    </view>

    <!-- 结果未知：超时、连接中断。不能宣布失败，也不能假装成功；
         内容确实还在输入框里，用常驻提示给出重试与保全两条路。 -->
    <view wx:if="{{status === 'unknown'}}" class="notice notice-warn">
      <view class="mark"></view>
      <view class="notice-body">
        <view class="notice-title">尚未确认保存</view>
        <view class="notice-text">内容还在输入框中。退出前请重试保存或复制内容。</view>
        <view class="notice-acts">
          <button class="btn btn-plain btn-sm" bindtap="onCopyDraft" disabled="{{saving}}">复制内容</button>
        </view>
      </view>
    </view>

    <!-- 确认被拒绝：服务端给了明确回执，原因按已知内容说，不编造 -->
    <view wx:if="{{status === 'rejected'}}" class="notice notice-err">
      <view class="mark"></view>
      <view class="notice-body">
        <view class="notice-title">未能保存</view>
        <view class="notice-text">{{errorText}}</view>
      </view>
    </view>

    <view class="a-action-footer">
    <button wx:if="{{lastSavedId}}" class="btn btn-block save-btn record-another" hover-class="a-primary-pressed" bindtap="onRecordAnother" disabled="{{photoBusy}}">再记一条</button>
    <button wx:else
      class="btn btn-block save-btn"
      hover-class="a-primary-pressed"
      bindtap="onSave"
      disabled="{{!canSave || saving || photoBusy}}"
    >{{saving ? '正在记下…' : status === 'unknown' ? '重试保存' : todoEnabled ? '添加待办' : '保存灵感'}}</button>
    </view>

    <view wx:if="{{copyNotice}}" class="hint-copy">{{copyNotice}}</view>

    <!-- 输入区常驻；这里的反馈与辅助操作仅属于刚确认的上一条记录。 -->
    <view wx:if="{{lastSavedId}}" class="notice notice-success notice-saved capture-result" aria-live="polite">
      <view class="mark"></view>
      <view class="notice-body">
        <view class="notice-title">上一条已记下</view>
        <view class="saved-quote">{{lastSavedExcerpt}}</view>
        <view class="notice-acts">
          <button class="btn-link" bindtap="onContinueSupplement">继续补充</button>
          <button class="btn-link" bindtap="onOrganizeSaved">整理这条</button>
        </view>
      </view>
    </view>
  </view>

</view>
