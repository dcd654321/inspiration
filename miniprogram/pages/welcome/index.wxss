.welcome-page { min-height: 100vh; box-sizing: border-box; padding: 100rpx 48rpx 80rpx; text-align: center; }
.welcome-mark { display: block; width: 160rpx; height: 160rpx; margin: 0 auto 38rpx; }
.welcome-copy { max-width: 580rpx; margin: 24rpx auto 68rpx; color: var(--ink-2); font-size: 30rpx; line-height: 1.8; }
.welcome-page .btn { margin-top: 18rpx; }
.welcome-hint { margin-top: 38rpx; font-size: 25rpx; color: var(--ink-3); line-height: 1.7; }
