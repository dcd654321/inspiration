.welcome-page { max-width: 960rpx; min-height: 100vh; box-sizing: border-box; margin: 0 auto; padding: 36rpx 40rpx calc(40rpx + env(safe-area-inset-bottom)); }
.welcome-brand { display: flex; align-items: center; gap: 18rpx; color: var(--ink-2); font-size: max(28rpx, 14px); font-weight: 500; }
.welcome-mark { display: block; flex: 0 0 auto; width: 72rpx; height: 72rpx; border-radius: 18rpx; }
.welcome-hero { margin-top: 32rpx; }
.welcome-title { color: var(--ink); font-size: max(48rpx, 24px); font-weight: 600; letter-spacing: -0.02em; line-height: 1.45; }
.welcome-copy { margin: 18rpx 0 28rpx; color: var(--ink-2); font-size: max(28rpx, 14px); line-height: 1.75; }
.welcome-page .btn { width: 100%; min-height: 44px; margin: 0; }
.welcome-section { margin-top: 44rpx; }
.welcome-section-title { margin-bottom: 20rpx; color: var(--ink); font-size: max(32rpx, 16px); font-weight: 600; line-height: 1.5; }
.welcome-steps { border-top: 1rpx solid var(--line); }
.welcome-step { display: flex; align-items: flex-start; gap: 22rpx; padding: 22rpx 0; border-bottom: 1rpx solid var(--line); }
.welcome-step-number { flex: 0 0 auto; width: 44rpx; height: 44rpx; margin-top: 2rpx; border-radius: 50%; background: var(--brand-soft); color: var(--brand); font-size: max(26rpx, 13px); font-weight: 600; text-align: center; line-height: 44rpx; }
.welcome-step-content { flex: 1; min-width: 0; }
.welcome-step-title, .welcome-question-title { color: var(--ink); font-size: max(29rpx, 15px); font-weight: 500; line-height: 1.6; }
.welcome-step-copy, .welcome-answer { margin-top: 6rpx; color: var(--ink-2); font-size: max(26rpx, 13px); line-height: 1.75; overflow-wrap: break-word; }
.welcome-help { margin-top: 36rpx; }
.welcome-question + .welcome-question { margin-top: 22rpx; }
.welcome-footer { margin-top: 40rpx; padding-top: 28rpx; border-top: 1rpx solid var(--line); }
.welcome-hint { margin-top: 16rpx; color: var(--ink-3); font-size: max(26rpx, 13px); line-height: 1.7; text-align: center; }
