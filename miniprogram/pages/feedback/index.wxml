<view class="page">
  <view class="page-title">{{reporting ? '举报这份分享' : '意见反馈'}}</view>
  <view class="page-sub">{{reporting ? '请说明你认为不合适的地方。' : '遇到问题或有建议，都可以告诉我们。'}}</view>
  <view wx:if="{{!reporting}}" class="feedback-categories">
    <button wx:for="{{categories}}" wx:key="value" data-value="{{item.value}}"
      class="feedback-category {{category === item.value ? 'feedback-category-on' : ''}}" bindtap="onCategory" disabled="{{busy}}">{{item.label}}</button>
  </view>
  <view class="field-label feedback-label">{{reporting ? '举报原因' : '具体情况'}}</view>
  <textarea class="feedback-editor" value="{{body}}" maxlength="1000" auto-height disabled="{{busy}}" cursor-spacing="24"
    aria-label="{{reporting ? '举报原因' : '具体情况'}}" placeholder="请写下具体情况（至少 10 字）" bindinput="onInput" />
  <view class="feedback-count">{{trimmedLength >= 10 ? body.length + ' / 1000' : '还需 ' + (10 - trimmedLength) + ' 字'}}</view>
  <view class="feedback-note">请勿填写密码、身份证号等敏感信息。提交后可在下方查看处理状态。</view>
  <view wx:if="{{error}}" class="notice notice-err"><text>{{error}}</text></view>
  <view wx:if="{{notice}}" class="notice"><text>{{notice}}</text></view>
  <button class="btn btn-block" bindtap="onSubmit" disabled="{{busy || !canSubmit}}">{{busy ? '提交中…' : (reporting ? '提交举报' : '提交反馈')}}</button>

  <view class="section-label">我的反馈</view>
  <view wx:if="{{loading}}" class="feedback-note">正在加载…</view>
  <view wx:elif="{{historyError}}" class="notice notice-err"><text>{{historyError}}</text></view>
  <view wx:elif="{{items.length === 0}}" class="feedback-note">还没有反馈记录。</view>
  <button wx:if="{{historyError}}" class="btn btn-plain btn-block" bindtap="onRetryHistory" disabled="{{loading}}">重新加载反馈</button>
  <view wx:for="{{items}}" wx:key="feedbackId" class="feedback-record">
    <view class="feedback-record-head"><text>{{item.categoryText}}</text><text>{{item.statusText}}</text></view>
    <view class="feedback-record-body">{{item.body}}</view>
    <view class="feedback-record-date">{{item.date}}</view>
  </view>
  <button wx:if="{{nextBefore}}" class="btn btn-plain btn-block" bindtap="onMore" disabled="{{loading}}">加载更多</button>
</view>
