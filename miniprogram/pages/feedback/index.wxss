.feedback-categories { display: flex; flex-wrap: wrap; gap: 7px; margin: 22px 0 0; padding-bottom: 19px; border-bottom: 1px solid var(--line); }
.feedback-categories .feedback-category { flex: 1; min-width: 0; min-height: 44px; box-sizing: border-box; padding: 9px 7px; border: 1px solid var(--line-strong); border-radius: 7px; color: var(--ink-2); background: var(--surface); font-size: max(28rpx, 14px); font-weight: 400; line-height: 1.6; }
.feedback-category::after { border: 0; }
.feedback-categories .feedback-category-on { color: var(--brand); background: var(--brand-soft); border-color: var(--brand); font-weight: 600; }
.feedback-categories .feedback-category[disabled] { opacity: 0.5; }
.feedback-label { margin: 21px 0 9px; color: var(--ink); font-size: max(26rpx, 13px); font-weight: 500; }
.feedback-editor { box-sizing: border-box; width: 100%; min-height: 180px; padding: 13px 14px; border: 1px solid var(--field-line); border-radius: 8px; color: var(--ink); background: var(--surface); font-size: max(32rpx, 16px); line-height: 1.9; }
.feedback-placeholder { color: var(--ink-2); }
.feedback-count { margin-top: 8px; color: var(--ink-2); font-size: max(24rpx, 12px); line-height: 1.8; text-align: right; font-variant-numeric: tabular-nums; }
.feedback-note { margin: 12px 0 20px; color: var(--ink-2); font-size: max(24rpx, 12px); line-height: 1.8; }
.feedback-submit { margin-top: 20px; }
.section-label { margin: 32px 0 12px; padding-top: 23px; border-top: 1px solid var(--line); color: var(--ink); font-size: max(32rpx, 16px); font-weight: 600; line-height: 1.6; }
.feedback-record { padding: 18px 0 20px; border-bottom: 1px solid var(--line); }
.feedback-record-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; color: var(--brand); font-size: max(24rpx, 12px); font-weight: 500; line-height: 1.8; }
.feedback-record-body { margin-top: 9px; color: var(--ink); font-size: max(32rpx, 16px); line-height: 1.8; white-space: pre-wrap; word-break: break-all; }
.feedback-record-date { margin-top: 10px; color: var(--ink-2); font-size: max(24rpx, 12px); line-height: 1.8; font-variant-numeric: tabular-nums; }
.feedback-more { margin-top: 20px; }
@media (max-width: 350px) { .feedback-categories { gap: 5px; } .feedback-categories .feedback-category { padding-right: 5px; padding-left: 5px; font-size: 13px; } }
