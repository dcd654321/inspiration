/* 中性黑，不带色相——带色偏的底色会让照片看起来偏色 */
page, .viewer { background: #1b1b1f; color: #f5f5f3; min-height: 100vh; }
swiper { height: 78vh; } swiper image { width: 100%; height: 100%; }
.caption, .error { text-align: center; padding: 24rpx 40rpx; font-size: 28rpx; line-height: 1.8; }

/* 照片失败时的占位动作：原因未知只给重试，不写「文件已删除」 */
.error-retry {
  display: block;
  width: auto;
  margin: 8rpx auto 0;
  padding: 0 36rpx;
  min-height: 88rpx;
  min-width: 88rpx;
  background: transparent;
  color: #f5f5f3;
  border: 2rpx solid rgba(245, 245, 243, 0.4);
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1;
}

.error-retry::after { border: none; }
