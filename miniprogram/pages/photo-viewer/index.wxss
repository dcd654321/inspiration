/* 图片承载面使用中性黑，状态与动作回到清晰的白色操作区。 */
page { background: #1b1b1f; }
.viewer { height: 100vh; min-height: 0; box-sizing: border-box; display: flex; flex-direction: column; overflow-y: auto; color: #f5f5f7; background: #1b1b1f; }
.viewer swiper { flex: 1; min-height: 0; height: 0; }
.viewer swiper image { display: block; width: 100%; height: 100%; }
.viewer-empty { flex: 1; }
.photo-placeholder, .viewer-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; min-height: 160px; padding: 28px 22px; text-align: center; }
.photo-placeholder { height: 100%; }
.photo-placeholder-title { color: #f5f5f7; font-size: max(34rpx, 17px); font-weight: 500; line-height: 1.6; }
.photo-placeholder-copy { margin-top: 9px; color: #c9c9d1; font-size: max(26rpx, 13px); line-height: 1.8; }
.viewer-status { flex-shrink: 0; padding: 13px 22px calc(15px + env(safe-area-inset-bottom)); color: var(--ink); background: var(--surface); }
.caption { color: var(--ink-2); font-size: max(24rpx, 12px); font-variant-numeric: tabular-nums; line-height: 1.8; text-align: center; }
.error { margin-top: 9px; color: var(--danger); font-size: max(26rpx, 13px); line-height: 1.8; text-align: center; }
.viewer .error-retry { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 48px; box-sizing: border-box; margin: 13px 0 0; padding: 11px 19px; border: 0; border-radius: 8px; color: #ffffff; background: var(--brand); font-size: max(30rpx, 15px); font-weight: 500; line-height: 1.6; }
.error-retry::after { border: 0; }
@media (max-width: 350px) { .viewer-status, .photo-placeholder, .viewer-empty { padding-right: 17px; padding-left: 17px; } }
