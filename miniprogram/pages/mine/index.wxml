<view class="page mine-page">
  <view class="profile-head">
    <image class="profile-mark" src="/assets/brand-mark.png" mode="aspectFit" />
    <view>
      <view class="page-title">我的</view>
      <view class="page-sub">记下、补充，再整理成可用稿。</view>
    </view>
  </view>

  <view class="settings-card">
    <view class="group-label">一起进步</view>
    <button class="menu-row" open-type="share" hover-class="menu-row-hover">
      <text class="menu-label">分享小程序</text>
      <image class="menu-arrow" src="/assets/icons/chevron-right.png" mode="aspectFit" aria-hidden="true" />
    </button>
    <button class="menu-row" bindtap="onOpenMyShares" hover-class="menu-row-hover">
      <text class="menu-label">我的分享</text>
      <image class="menu-arrow" src="/assets/icons/chevron-right.png" mode="aspectFit" aria-hidden="true" />
    </button>
  </view>

  <view class="settings-card">
    <view class="group-label">数据与支持</view>
    <button class="menu-row" bindtap="onToggleInfo" data-section="privacy" hover-class="menu-row-hover" aria-expanded="{{expandedInfo === 'privacy'}}">
      <view class="menu-label">
        <view>数据与隐私</view>
        <view class="menu-sub">记录与分享范围</view>
      </view>
      <image class="menu-arrow {{expandedInfo === 'privacy' ? 'menu-arrow-open' : ''}}" src="/assets/icons/chevron-right.png" mode="aspectFit" aria-hidden="true" />
    </button>
    <view class="info-content" wx:if="{{expandedInfo === 'privacy'}}">
      <view class="info-note" wx:for="{{privacyNotes}}" wx:key="*this">{{item}}</view>
    </view>
    <button class="menu-row" bindtap="onToggleInfo" data-section="help" hover-class="menu-row-hover" aria-expanded="{{expandedInfo === 'help'}}">
      <text class="menu-label">使用帮助</text>
      <image class="menu-arrow {{expandedInfo === 'help' ? 'menu-arrow-open' : ''}}" src="/assets/icons/chevron-right.png" mode="aspectFit" aria-hidden="true" />
    </button>
    <view class="info-content" wx:if="{{expandedInfo === 'help'}}">
      <view class="info-note" wx:for="{{helpNotes}}" wx:key="*this">{{item}}</view>
    </view>
    <button class="menu-row" open-type="feedback" hover-class="menu-row-hover">
      <text class="menu-label">意见与问题反馈</text>
      <image class="menu-arrow" src="/assets/icons/chevron-right.png" mode="aspectFit" aria-hidden="true" />
    </button>
  </view>
</view>
