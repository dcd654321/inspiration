<view class="page">
  <view class="page-title">我的</view>

  <view class="section-head" style="margin: 44rpx 0 18rpx"><text class="k">能力</text></view>
  <view class="panel">
    <view class="kv">
      <text>云端同步</text>
      <text class="{{cloudEnabled ? 'val-on' : 'val-off'}}">{{cloudEnabled ? '已启用' : '未启用'}}</text>
    </view>
    <view class="kv">
      <text>AI 扩展</text>
      <text class="{{aiEnabled ? 'val-on' : 'val-off'}}">{{aiEnabled ? '已启用' : '未启用'}}</text>
    </view>
  </view>

  <view class="section-head" style="margin: 52rpx 0 18rpx"><text class="k">数据与隐私</text></view>
  <view class="panel">
    <view class="prose">{{privacyNote}}</view>
  </view>

  <view class="section-head" style="margin: 52rpx 0 18rpx"><text class="k">反馈</text></view>
  <button class="btn btn-plain btn-block" open-type="feedback">提交反馈</button>
</view>
