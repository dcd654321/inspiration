.profile-head {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-top: 32rpx;
  padding-bottom: 36rpx;
  border-bottom: 1px solid var(--line);
}

.profile-mark {
  flex: 0 0 auto;
  width: max(88rpx, 44px);
  height: max(88rpx, 44px);
  border-radius: 18rpx;
}

.profile-name {
  color: var(--ink);
  font-size: max(32rpx, 16px);
  font-weight: 600;
  line-height: 1.5;
}

.profile-head .page-sub {
  margin-top: 6rpx;
  font-size: max(24rpx, 12px);
  line-height: 1.7;
}

.settings-card {
  margin-top: 34rpx;
}

.group-label {
  margin-bottom: 8rpx;
  color: var(--ink-2);
  font-size: max(24rpx, 12px);
  line-height: 1.6;
}

.mine-page .menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  width: 100%;
  min-height: max(104rpx, 52px);
  margin: 0;
  padding: 24rpx 0;
  box-sizing: border-box;
  border: none;
  border-bottom: 1px solid var(--line);
  border-radius: 0;
  background: transparent;
  color: var(--ink);
  font-size: max(32rpx, 16px);
  font-weight: 400;
  line-height: 1.5;
  text-align: left;
}

.menu-row::after {
  border: none;
}

.mine-page .menu-row-hover {
  background: var(--brand-soft);
}

.menu-label {
  flex: 1;
  min-width: 0;
  white-space: normal;
  word-break: break-all;
}

.menu-sub {
  margin-top: 4rpx;
  color: var(--ink-2);
  font-size: max(24rpx, 12px);
  line-height: 1.6;
}

.menu-arrow {
  flex: 0 0 auto;
  width: 30rpx;
  height: 30rpx;
  margin-right: 2rpx;
}

.menu-arrow-open {
  transform: rotate(90deg);
}

.info-content {
  padding: 20rpx 0 28rpx;
  border-bottom: 1px solid var(--line);
  color: var(--ink-2);
  font-size: max(28rpx, 14px);
  line-height: 1.85;
}

.info-note + .info-note {
  margin-top: 16rpx;
}

.mine-page .profile-head { margin-top: 0; gap: 14px; padding: 12px 0 24px; }
.mine-page .profile-mark { width: 44px; height: 44px; border-radius: 9px; }
.mine-page .menu-row { min-height: 58px; padding: 12px 0; font-size: 15px; }
.mine-page .menu-arrow { width: 18px; height: 18px; }
