.profile-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

/* 与记录页标题区的品牌图形同尺寸、同圆角——同一个东西在两页不该长得不一样 */
.profile-mark {
  flex: 0 0 auto;
  width: 104rpx;
  height: 104rpx;
  border-radius: 26rpx;
}

.privacy-panel {
  padding: 10rpx 32rpx;
}

.privacy-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx 0;
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--ink-2);
  border-bottom: 2rpx solid var(--line);
}

.privacy-item:last-child { border-bottom: none; }

/* 圆点是结构不是语义，用中性墨色。琥珀只留给品牌图形里的灵光标记——
   规则越窄越守得住，掺一个例外进来，下次就没人记得边界在哪。 */
.privacy-dot {
  flex: 0 0 auto;
  width: 12rpx;
  height: 12rpx;
  margin-top: 16rpx;
  border-radius: 50%;
  background: var(--ink-3);
}

.use-panel {
  padding: 30rpx 32rpx 32rpx;
}

.use-copy {
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--ink-2);
  margin-bottom: 24rpx;
}

.about-panel {
  padding: 30rpx 32rpx 34rpx;
}

.about-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.about-copy {
  margin-top: 12rpx;
  font-size: 27rpx;
  line-height: 1.75;
  color: var(--ink-2);
}
