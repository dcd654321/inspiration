.kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  font-size: 29rpx;
  border-bottom: 2rpx solid var(--line);
}

.kv:last-child {
  border-bottom: none;
}

.val-off {
  font-size: 27rpx;
  color: var(--ink-3);
}

.val-on {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--brand);
}

.prose {
  padding: 28rpx 32rpx 32rpx;
  font-size: 26rpx;
  line-height: 1.78;
  color: var(--ink-2);
}
