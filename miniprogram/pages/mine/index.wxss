page {
  --paper: #f5f7f2;
  --ink: #3f5049;
  --ink-2: #65756c;
  --line: #dfe6dc;
  background: var(--paper);
}

.mine-page {
  padding: 40rpx 36rpx calc(64rpx + env(safe-area-inset-bottom));
}

.profile-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.profile-mark {
  flex: 0 0 auto;
  width: 104rpx;
  height: 104rpx;
  border-radius: 26rpx;
}

.settings-card {
  padding: 2rpx 30rpx;
  margin-top: 40rpx;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 28rpx;
}

.group-label {
  margin-top: 28rpx;
  color: var(--ink-2);
  font-size: 28rpx;
  font-size: max(28rpx, 14px);
  line-height: 1.5;
}

.mine-page .menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  width: 100%;
  min-height: 108rpx;
  min-height: max(108rpx, 52px);
  margin: 0;
  padding: 26rpx 0;
  box-sizing: border-box;
  border: none;
  border-bottom: 1px solid var(--line);
  border-radius: 0;
  background: transparent;
  color: var(--ink);
  font-size: 30rpx;
  font-size: max(30rpx, 16px);
  font-weight: 400;
  line-height: 1.5;
  text-align: left;
}

.menu-row::after {
  border: none;
}

.settings-card .menu-row:last-child {
  border-bottom: none;
}

.mine-page .menu-row-hover {
  background: var(--paper);
}

.menu-label {
  flex: 1;
  min-width: 0;
  white-space: normal;
  word-break: break-all;
}

.menu-sub {
  margin-top: 2rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  font-size: max(26rpx, 13px);
  line-height: 1.5;
}

.menu-arrow {
  flex: 0 0 auto;
  width: 30rpx;
  height: 30rpx;
  margin-right: 2rpx;
}

.menu-arrow-open {
  transform: rotate(90deg);
}

.info-content {
  padding: 20rpx 0 26rpx;
  border-bottom: 1px solid var(--line);
  color: var(--ink-2);
  font-size: 28rpx;
  font-size: max(28rpx, 14px);
  line-height: 1.75;
}

.info-note + .info-note {
  margin-top: 16rpx;
}
