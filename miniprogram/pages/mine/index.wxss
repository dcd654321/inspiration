.profile-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-mark {
  flex: 0 0 auto;
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
}

.privacy-panel {
  padding: 10rpx 32rpx;
}

.privacy-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx 0;
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--ink-2);
  border-bottom: 2rpx solid var(--line);
}

.privacy-item:last-child { border-bottom: none; }

.privacy-dot {
  flex: 0 0 auto;
  width: 12rpx;
  height: 12rpx;
  margin-top: 16rpx;
  border-radius: 50%;
  background: var(--spark);
}

.use-panel {
  padding: 30rpx 32rpx 32rpx;
}

.use-copy {
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--ink-2);
  margin-bottom: 24rpx;
}

.remote-item {
  padding: 24rpx 0;
  border-top: 2rpx solid var(--line);
}

.remote-text {
  display: block;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink);
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.about-panel {
  padding: 30rpx 32rpx 34rpx;
}

.about-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.about-copy {
  margin-top: 12rpx;
  font-size: 27rpx;
  line-height: 1.75;
  color: var(--ink-2);
}
