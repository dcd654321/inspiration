<view class="page material-page">
  <view class="page-title">选材整理</view>
  <view class="page-sub">从多条灵感中选择内容，整理成一份稿件。</view>
  <view class="selection-note">未另存的稿件离开后不保留，请先复制或另存。</view>
  <view wx:if="{{!ready}}" class="empty"><view class="ed">正在读取素材…</view></view>
  <view wx:elif="{{error && !total}}" class="empty">
    <view class="notice notice-err" aria-live="polite">{{error}}</view>
    <button class="btn btn-plain btn-block" bindtap="load">重新读取</button>
  </view>
  <block wx:elif="{{phase === 'select'}}">
    <view class="section-label">选择使用方式</view>
    <view class="template-options"><button wx:for="{{templates}}" wx:key="id" class="template-option {{templateId === item.id ? 'template-selected' : ''}}" data-template="{{item.id}}" bindtap="onTemplate">{{item.name}}</button></view>
    <view class="selection-note">只整理选中的文字，不自动补写。数字表示内容进入稿件的顺序。</view>
    <input class="material-search" value="{{query}}" bindinput="onSearch" maxlength="100" placeholder="搜索素材文字" aria-label="搜索素材文字" />
    <view class="material-tools"><button class="btn-link" bindtap="onSelectedOnly">{{selectedOnly ? '显示全部' : '只看已选'}}</button><button class="btn-link" bindtap="onRefresh">刷新素材</button></view>
    <view wx:if="{{!options.length}}" class="empty-options">{{total ? '没有符合条件的素材，可调整搜索或显示全部。' : '还没有可用素材，请先记录想法。'}}</view>
    <button wx:for="{{options}}" wx:key="key" class="option" data-key="{{item.key}}" bindtap="onToggle" aria-label="{{item.selected ? '取消选择' : '选择'}}{{item.kind}}">
      <text class="option-check {{item.selected ? 'option-checked' : ''}}">{{item.order || ''}}</text>
      <view class="option-body"><text class="option-time">{{item.kind}} · {{item.time}}</text><text wx:if="{{item.kind === '补充'}}" class="material-source">来自：{{item.sourceText}}</text><text class="option-content">{{item.content}}</text></view>
    </button>
    <view class="material-footer"><view wx:if="{{error}}" class="notice notice-err" aria-live="polite">{{error}}</view><view class="selection-note">已选 {{selectedCount}} 段 · {{sourceCount}} 条灵感</view><button class="btn btn-block" bindtap="onGenerate" disabled="{{!selectedCount}}">整理成稿</button><button wx:if="{{draft}}" class="btn btn-plain btn-block" bindtap="onResumeDraft">返回当前稿件</button></view>
  </block>
  <block wx:else>
    <button class="back-select" bindtap="onBackToSelection" disabled="{{busy}}">返回选材</button>
    <textarea class="draft-editor" value="{{draft}}" maxlength="-1" bindinput="onInput" disabled="{{busy}}" aria-label="编辑稿件" />
    <view class="draft-count {{draft.length > maxLength ? 'count-over' : ''}}">
      <text wx:if="{{draft.length > maxLength}}">另存最多{{maxLength}}字符，当前超出{{draft.length - maxLength}}字符。</text>
      <text wx:else>{{draft.length}}字符 · 另存最多{{maxLength}}字符</text>
    </view>
    <button class="btn btn-block main-action" bindtap="onCopy" disabled="{{busy}}">复制稿件</button>
    <button class="btn btn-quiet btn-block secondary-action" bindtap="onSave" disabled="{{busy || (savedId && savedDraft === draft)}}">{{savedId && savedDraft === draft ? '已另存' : '另存为新灵感'}}</button>
    <button wx:if="{{savedId}}" class="btn btn-plain btn-block secondary-action" bindtap="onOpenSaved" disabled="{{busy}}">查看新灵感</button>
  </block>
  <view wx:if="{{error && total && phase !== 'select'}}" class="notice notice-err" aria-live="polite">{{error}}</view>
  <view wx:if="{{notice}}" class="notice notice-success" aria-live="polite">{{notice}}</view>
</view>
