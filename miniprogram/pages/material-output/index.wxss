@import "../output/index.wxss";
.material-page { padding-bottom: calc(420rpx + env(safe-area-inset-bottom)); }
.material-page .option { font-weight: normal; }
.material-page .back-select { display: flex; align-items: center; justify-content: flex-start; width: 100%; line-height: 1; font-weight: normal; }
.material-search { margin-top: 32rpx; min-height: 88rpx; padding: 0 24rpx; border: 2rpx solid var(--line); background: var(--surface); border-radius: 16rpx; font-size: 28rpx; }
.material-tools { display: flex; justify-content: space-between; }
.material-tools .btn-link { width: auto; margin: 0; }
.material-source { color: var(--ink-3); font-size: 24rpx; margin: 8rpx 0; line-height: 1.5; }
.material-footer { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; padding: 16rpx 40rpx calc(20rpx + env(safe-area-inset-bottom)); background: var(--paper); border-top: 2rpx solid var(--line); }
.material-footer .selection-note { margin: 0 0 12rpx; }
.material-footer .btn + .btn { margin-top: 12rpx; }
.material-footer .notice { margin: 0 0 16rpx; }
