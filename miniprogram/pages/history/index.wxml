<view class="page" wx:if="{{ready}}">
  <block wx:if="{{missing}}">
    <view class="empty">
      <view class="et">找不到这条灵感</view>
      <view class="ed">这条灵感不存在或已经删除。</view>
    </view>
  </block>

  <block wx:else>
    <view class="hv-now">
      <view class="hv-now-k">当前内容</view>
      <view class="hv-now-t">{{current}}</view>
    </view>

    <view class="history-head">共 {{versions.length}} 条修改记录</view>

    <!-- 只读。没有编辑入口，也没有删除入口——这是「你说过的话不会被悄悄抹掉」的界面体现 -->
    <view class="history-list">
      <view wx:for="{{versions}}" wx:key="id" class="hv">
        <view class="hv-m">修改于 {{item.time}}</view>
        <view class="hv-t">{{item.text}}</view>
      </view>
    </view>
  </block>
</view>
