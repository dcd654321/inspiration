.history-head {
  margin: 52rpx 0 14rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.history-list {
  position: relative;
  padding-left: 32rpx;
}

.history-list::before {
  content: "";
  position: absolute;
  left: 7rpx;
  top: 30rpx;
  bottom: 34rpx;
  width: 2rpx;
  background: var(--line-strong);
}

/* 修改记录是开放列表，不用厚重卡片包裹每一条 */
.hv {
  position: relative;
  padding: 26rpx 0 30rpx;
  border-bottom: 2rpx solid var(--line);
}

.hv::before {
  content: "";
  position: absolute;
  left: -32rpx;
  top: 34rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--paper);
  border: 4rpx solid var(--spark);
}

.hv-t {
  font-size: 29rpx;
  line-height: 1.72;
  letter-spacing: 0.01em;
  color: var(--ink-2);
}

.hv-m {
  font-size: 26rpx;
  color: var(--ink-3);
  margin-bottom: 12rpx;
}

/* 当前内容先出现，用户无需滚到底部才能建立比较基准 */
.hv-now {
  padding: 32rpx 34rpx 34rpx;
  border-left: 6rpx solid var(--spark);
  border-radius: 20rpx;
  background: var(--surface);
}

.hv-now-k {
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: var(--brand);
  margin-bottom: 14rpx;
}

.hv-now-t {
  font-size: 29rpx;
  line-height: 1.72;
  letter-spacing: 0.01em;
  color: var(--ink);
}
