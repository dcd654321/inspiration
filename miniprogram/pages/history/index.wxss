/* 当前文字与旧版本使用同一阅读宽度，按细线连续排列。 */
.history-title { margin-bottom: 24px; }
.history-subject, .history-state { margin-bottom: 10px; color: var(--ink-2); font-size: max(24rpx, 12px); line-height: 1.8; }
.hv-now { padding: 0 0 24px; border-bottom: 1px solid var(--line); }
.hv-now-k { margin-bottom: 10px; color: var(--brand); font-size: max(26rpx, 13px); font-weight: 600; line-height: 1.6; }
.hv-now-t, .hv-t { white-space: pre-wrap; word-break: break-all; color: var(--ink); font-size: max(32rpx, 16px); font-weight: 400; line-height: 1.9; }
.hv-now-t { font-size: max(34rpx, 17px); }
.history-head { margin: 26px 0 8px; color: var(--ink); font-size: max(30rpx, 15px); font-weight: 600; line-height: 1.6; }
.history-section-title { margin: 20px 0 0; color: var(--ink-2); font-size: max(26rpx, 13px); font-weight: 500; line-height: 1.7; }
.hv { padding: 18px 0 20px; border-bottom: 1px solid var(--line); }
.hv-m { margin-bottom: 10px; color: var(--ink-2); font-size: max(24rpx, 12px); font-variant-numeric: tabular-nums; line-height: 1.8; }
.supplement-history { margin-top: 30px; }
.supplement-history > .history-section-title:first-child { margin: 0 0 12px; color: var(--ink); font-size: max(30rpx, 15px); font-weight: 600; }
.hv-empty { padding: 38px 0 28px; text-align: center; }
.hv-empty .et { color: var(--ink); font-size: max(34rpx, 17px); font-weight: 600; }
.hv-empty .ed { margin-top: 9px; color: var(--ink-2); font-size: max(26rpx, 13px); line-height: 1.8; }
@media (max-width: 350px) { .hv-now-t { font-size: 16px; } }
