.error-empty {
  margin-top: 36rpx;
}

.todo-summary { margin-top: 10rpx; color: var(--brand); font-size: max(26rpx, 13px); line-height: 1.6; }

/* 列表右上入口：小屏也不缩成两行，热区保持 88rpx */
.add-link {
  flex: 0 0 auto;
  white-space: nowrap;
  margin-left: 0;
  margin-right: 0;
  width: auto;
}

.search-box { display: flex; align-items: center; gap: 16rpx; background: var(--surface); border: 1px solid var(--field-line); border-radius: 20rpx; padding: 12rpx 24rpx; margin-top: 24rpx; }
.search-box input { flex: 1; min-width: 0; height: 76rpx; font-size: 29rpx; font-size: max(29rpx, 16px); }
.list-filters, .stage-filters { display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx; }
.list-filters { margin: 20rpx 0 12rpx; }
.stage-filters { margin-bottom: 20rpx; }
.filter-chip { margin: 0; border: 1rpx solid var(--line-strong); background: transparent; border-radius: 44rpx; padding: 0 22rpx; min-height: 88rpx; line-height: 88rpx; color: var(--ink-2); }
/* 两层选择器覆盖 button[size="mini"] 的默认字号、字重与内边距。 */
.list-filters .filter-chip, .stage-filters .filter-chip { width: auto; flex: 1 1 auto; margin: 0; padding: 0 12rpx; box-sizing: border-box; white-space: nowrap; font-size: 24rpx; font-size: max(24rpx, 12px); font-weight: 400; min-height: max(88rpx, 44px); line-height: max(88rpx, 44px); }
.stage-filters .filter-chip { background: var(--surface); }
.filter-chip.selected { background: var(--brand-soft); color: var(--brand); border-color: var(--brand-line); }
.stage-filters .filter-chip.selected { background: var(--brand-soft); }
.list-filters .filter-chip.selected, .stage-filters .filter-chip.selected { font-weight: 500; }
.filter-chip::after { border: 0; }
.filter-reset { display: flex; justify-content: flex-end; margin: -12rpx 0 4rpx; }
.filter-reset .btn-link { margin: 0; }

.match-snippet { font-size: 25rpx; font-size: max(25rpx, 14px); line-height: 1.65; color: var(--ink-2); margin-top: 12rpx; word-break: break-all; }
.match-source { color: var(--ink-2); }
.item-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; color: var(--ink-2); font-size: 23rpx; font-size: max(23rpx, 13px); }
.item-tags text { background: #edede7; border-radius: 8rpx; padding: 4rpx 12rpx; }
/* 段落头：区名与数量在左，选材成稿入口在右 */
.list-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8rpx 16rpx; margin: 32rpx 0 12rpx; }
.list-head-title { display: flex; align-items: baseline; gap: 14rpx; min-width: 0; }
.list-head-title .k { font-size: 27rpx; font-size: max(27rpx, 14px); font-weight: 600; letter-spacing: 0.02em; color: var(--ink-2); }
.list-head-title .v { font-size: 26rpx; font-size: max(26rpx, 13px); color: var(--ink-3); }
.list-head-acts { display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx; }
.refresh-status { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 12px; color: var(--ink-2); font-size: max(26rpx, 13px); line-height: 1.6; }
.refresh-status text { flex: 1; }
.refresh-status .btn-link { flex: 0 0 auto; margin: 0; }
