.list-notice {
  margin-top: 32rpx;
}

.error-empty {
  margin-top: 36rpx;
}
.search-box { display: flex; align-items: center; gap: 16rpx; background: #fff; border: 1rpx solid #dedfd9; border-radius: 20rpx; padding: 12rpx 24rpx; margin-top: 24rpx; }
.search-box input { flex: 1; min-width: 0; height: 76rpx; font-size: 29rpx; }
.list-filters { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 20rpx 0; }
.filter-chip { margin: 0; border: 1rpx solid #dedfd9; background: transparent; border-radius: 44rpx; font-size: 25rpx; padding: 0 22rpx; min-height: 88rpx; line-height: 88rpx; color: #59625c; }
.list-filters .filter-chip { width: auto; flex: 0 0 auto; margin: 0; box-sizing: border-box; }
.filter-chip.selected { background: var(--brand-soft); color: var(--brand); border-color: var(--brand-line); }
.filter-chip::after { border: 0; }
.review-setting { display: flex; justify-content: space-between; align-items: center; font-size: 26rpx; color: #64716a; }
.review-card { background: var(--brand-soft); border: 1rpx solid var(--brand-line); padding: 28rpx; border-radius: 24rpx; margin: 22rpx 0; }
.review-heading { font-size: 26rpx; color: var(--brand); }
.review-text { font-size: 30rpx; line-height: 1.65; margin: 16rpx 0 24rpx; white-space: pre-wrap; word-break: break-all; }
.review-actions { display: flex; justify-content: space-between; align-items: center; }
.match-snippet { font-size: 25rpx; line-height: 1.65; color: #59665d; margin-top: 12rpx; word-break: break-all; }
.match-source { color: #476b59; }
.stage-picker { min-height: 88rpx; display: flex; align-items: center; }
.item-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; color: #526550; font-size: 23rpx; }
.item-tags text { background: #edf1e9; border-radius: 8rpx; padding: 4rpx 12rpx; }
.material-entry { margin: 16rpx 0 24rpx; }
