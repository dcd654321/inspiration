<view class="page">
  <view class="title">我的灵感</view>
  <view class="hint">按最近更新时间倒序排列。</view>

  <view wx:if="{{inspirations.length === 0}}" class="placeholder">
    这里还没有灵感。工程骨架版本尚未接入数据，记录与列表读取将在
    add-inspiration-mvp 实施后可用。
  </view>

  <view class="card" wx:for="{{inspirations}}" wx:key="id">
    <view>{{item.text}}</view>
  </view>

  <button class="button-primary" bindtap="onAdd">去记一条</button>
</view>
