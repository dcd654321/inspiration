<view class="page">
  <view class="page-heading">
    <view class="page-title">我的灵感</view>
    <button class="btn-link" bindtap="onAdd">记一条</button>
  </view>

  <view class="search-box">
    <input value="{{query}}" bindinput="onSearch" maxlength="100" placeholder="搜索正文、补充或标签" aria-label="搜索正文、补充或标签" confirm-type="search" />
    <button wx:if="{{query}}" class="btn-link" bindtap="onClearSearch">清空</button>
  </view>
  <view class="list-filters">
    <button size="mini" class="filter-chip {{filter === 'all' ? 'selected' : ''}}" data-filter="all" bindtap="onFilter">全部</button>
    <button size="mini" class="filter-chip {{filter === 'supplemented' ? 'selected' : ''}}" data-filter="supplemented" bindtap="onFilter">有补充</button>
    <button size="mini" class="filter-chip {{filter === 'recent' ? 'selected' : ''}}" data-filter="recent" bindtap="onFilter">最近七天</button>
    <button size="mini" class="filter-chip {{filter === 'merged' ? 'selected' : ''}}" data-filter="merged" bindtap="onFilter">已合并</button>
  </view>
  <view class="review-setting"><picker range="{{stages}}" range-key="label" value="{{stageIndex}}" bindchange="onStageFilter"><view class="stage-picker">{{stages[stageIndex].label}} · 筛选</view></picker><button wx:if="{{aiEnabled}}" class="btn-link" bindtap="onSummarize">汇总多条灵感</button></view>
  <view wx:if="{{!loading && !error}}" class="review-setting"><text>每日回顾</text><switch checked="{{reviewEnabled}}" bindchange="onReviewSetting" color="#34377f" aria-label="每日回顾" /></view>
  <button wx:if="{{!loading && !error && total > 0}}" class="btn btn-quiet btn-block material-entry" bindtap="onMaterialOutput">选材整理 · 组合多条灵感</button>
  <view wx:if="{{reviewError}}" class="notice notice-warn">{{reviewError}}</view>
  <view wx:if="{{reviewItem && !query && !stage && filter === 'all'}}" class="review-card">
    <view class="review-heading">继续一个想法</view>
    <view class="review-text">{{reviewItem.excerpt}}</view>
    <view class="review-actions"><button class="btn btn-sm" data-id="{{reviewItem.id}}" data-review="true" bindtap="onOpen">继续补充</button><button class="btn-link" bindtap="onDismissReview">今天跳过</button></view>
  </view>

  <view wx:if="{{backupNotice}}" class="notice notice-warn list-notice"><view class="mark"></view><text>{{backupNotice}}</text></view>

  <view wx:if="{{loading}}" class="skeleton-list">
    <view class="skeleton-row" wx:for="{{[1, 2, 3]}}" wx:key="*this">
      <view class="skeleton-line"></view>
      <view class="skeleton-line"></view>
    </view>
  </view>

  <block wx:elif="{{error && items.length === 0}}">
    <view class="empty error-empty">
      <view class="et">暂时无法读取灵感</view>
      <view class="ed">这次读取没有完成，请稍后重试。</view>
    </view>
    <button class="btn btn-plain btn-block" style="margin-top: 32rpx" bindtap="onRetry">重新读取</button>
  </block>

  <block wx:elif="{{items.length === 0 && (query || stage || filter !== 'all')}}">
    <view class="empty"><view class="et">没有找到匹配的灵感</view><view class="ed">试试其他关键词，或清空筛选。</view></view>
    <button class="btn btn-quiet btn-block" bindtap="onClearSearch">查看全部</button>
  </block>

  <block wx:elif="{{items.length === 0}}">
    <view class="empty">
      <image class="empty-mark" src="/assets/brand-mark.png" mode="aspectFit" />
      <view class="et">还没有灵感</view>
      <view class="ed">从一个想法开始，之后可以继续补充、整理并复制使用。</view>
    </view>
    <button class="btn btn-block" style="margin-top: 32rpx" bindtap="onAdd">记下第一个想法</button>
  </block>

  <block wx:else>
    <view wx:if="{{error}}" class="notice notice-warn list-notice">
      <view class="mark"></view>
      <text>{{error}}</text>
    </view>
    <button wx:if="{{error}}" class="btn btn-plain btn-block" style="margin-top: 20rpx" bindtap="onRetry">重新读取</button>

    <view class="list" style="margin-top: 36rpx">
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="row"
        hover-class="row-active"
        hover-stay-time="80"
        data-id="{{item.id}}"
        bindtap="onOpen"
      >
        <view class="row-main">
          <view class="body">{{item.excerpt}}</view>
          <view class="item-tags"><text>{{item.merged ? '已合并' : item.stageLabel}}</text><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text></view>
          <view wx:if="{{item.matchText}}" class="match-snippet"><text class="match-source">{{item.matchSource}} · </text><text>{{item.matchText}}</text></view>
          <view class="meta">
            <text>{{item.time}}</text>
            <block wx:if="{{item.supplements}}">
              <view class="sep"></view>
              <text>{{item.supplements}}</text>
            </block>
          </view>
        </view>
        <text class="row-enter">查看</text>
      </view>
    </view>
  </block>
</view>
