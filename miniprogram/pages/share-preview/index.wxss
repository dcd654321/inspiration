.section-label { margin-top: 40rpx; font-size: 30rpx; font-weight: 600; }
.selection-note, .share-rule { margin-top: 12rpx; font-size: 26rpx; line-height: 1.7; color: var(--ink-2); }
.share-option { display: flex; align-items: flex-start; gap: 18rpx; width: 100%; margin-top: 16rpx; padding: 24rpx; text-align: left; background: var(--surface); border: 2rpx solid var(--line); border-radius: 18rpx; }
.share-option::after { border: 0; }
.share-option-on { border-color: var(--brand-line); background: var(--brand-soft); }
.share-check { width: 34rpx; flex: 0 0 34rpx; color: var(--brand); }
.share-option-text { flex: 1; font-size: 27rpx; line-height: 1.6; white-space: pre-wrap; }
.share-preview { margin-top: 20rpx; padding: 30rpx; background: var(--surface); border-radius: 20rpx; font-size: 28rpx; line-height: 1.75; white-space: pre-wrap; overflow-wrap: anywhere; }
.share-rule { padding: 20rpx 0; }
.share-action { margin-top: 16rpx; }
.poster-section { margin-top: 38rpx; }
.poster-scroll { width: 100%; white-space: nowrap; margin: 20rpx 0; }
.poster-thumb { display: inline-block; width: 280rpx; margin-right: 16rpx; border-radius: 12rpx; }
.poster-canvas { position: fixed; left: -2000px; top: 0; width: 750px; height: 1000px; }
