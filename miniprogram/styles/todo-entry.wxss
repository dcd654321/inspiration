/* 记录、补充与待办页共用：设置待办使用清单图标，完成事项使用勾选。 */
.todo-entry-icon { display: inline-flex; flex-direction: column; justify-content: center; gap: 8rpx; flex: 0 0 40rpx; width: 40rpx; height: 40rpx; color: var(--brand); }
.todo-entry-line { display: flex; align-items: center; gap: 6rpx; }
.todo-entry-line::before { content: ""; width: 7rpx; height: 7rpx; border: 1px solid currentColor; border-radius: 2rpx; }
.todo-entry-line::after { content: ""; flex: 1; height: 2rpx; background: currentColor; border-radius: 2rpx; }
.todo-setting { margin-top: 16rpx; border: 1px solid var(--line); border-radius: 16rpx; overflow: hidden; background: var(--surface); }
.todo-setting.is-active { border-color: var(--brand-line); background: var(--brand-soft); }
.page .todo-setting-toggle { display: flex; align-items: center; gap: 16rpx; box-sizing: border-box; width: 100%; min-height: max(116rpx, 58px); padding: 16rpx 20rpx; background: transparent; border: 0; border-radius: 0; text-align: left; line-height: 1.4; }
.todo-setting-toggle::after, .todo-add-entry::after, .todo-date-chip::after { border: 0; }
.todo-setting-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 4rpx; }
.todo-setting-title { color: var(--ink); font-size: max(28rpx, 14px); font-weight: 500; }
.todo-setting-hint { color: var(--ink-2); font-size: max(24rpx, 13px); font-weight: 400; line-height: 1.5; white-space: normal; }
.todo-setting-switch { display: flex; align-items: center; box-sizing: border-box; flex: 0 0 64rpx; width: 64rpx; height: 38rpx; padding: 4rpx; border-radius: 24rpx; background: var(--ink-3); }
.todo-setting-knob { width: 30rpx; height: 30rpx; border-radius: 50%; background: var(--surface); }
.is-active .todo-setting-switch { justify-content: flex-end; background: var(--brand); }
.todo-setting-toggle[disabled] { opacity: 0.55; }
.todo-setting-dates { margin: 0 20rpx; padding: 16rpx 0; border-top: 1px solid var(--brand-line); }
.todo-date-label { color: var(--ink-2); font-size: max(24rpx, 13px); line-height: 1.5; }
.todo-date-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; }
.page .todo-date-chip { display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: max(88rpx, 44px); min-width: max(88rpx, 44px); margin: 0; padding: 0 16rpx; border: 1px solid var(--brand-line); border-radius: 12rpx; background: var(--surface); color: var(--ink-2); font-size: max(26rpx, 13px); font-weight: 400; line-height: 1.4; }
.page .todo-date-chip.chosen { border-color: var(--brand); background: var(--brand); color: #fff; font-weight: 500; }
.page .todo-date-chip[disabled], .todo-date-picker[disabled] { opacity: 0.55; }
.page .todo-add-entry { display: inline-flex; align-items: center; justify-content: center; gap: 12rpx; min-height: max(88rpx, 44px); margin: 0; padding: 0 20rpx; border: 1px solid var(--brand-line); border-radius: 14rpx; background: var(--brand-soft); color: var(--brand); font-size: max(26rpx, 13px); line-height: 1.4; }
.todo-add-entry .todo-entry-icon { flex-basis: 32rpx; width: 32rpx; height: 32rpx; gap: 6rpx; }
.todo-add-entry[disabled] { opacity: 0.55; }
